---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import heroImage from '~/assets/images/copper/hero-copper-parts-transparent.webp';
import applicationImage from '~/assets/images/generated/copper-am-sic-power-module-cold-plate-case-cover.webp';
import { createCopperServiceSchema, createItemListSchema } from '~/utils/structured-data';

const rfqEmail = 'info@szcomo.com';
const rfqEmailHref = `mailto:${rfqEmail}`;
const whatsappHref =
  'https://wa.me/8615301541312?text=Hello%2C%20I%20would%20like%20to%20discuss%20a%20copper%203D%20printing%20project.';

const metadata = {
  title: 'Copper 3D Printing Service | Pure Copper & CuCrZr LPBF',
  ignoreTitleTemplate: true,
  description:
    'Copper 3D printing service for pure copper and CuCrZr LPBF parts. Send CAD for cold plates, heat exchangers, heat sinks, busbars, induction coils, RF, and semiconductor hardware.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/copper/hero-copper-parts-transparent.webp',
        width: 1200,
        height: 675,
      },
    ],
    type: 'website',
  },
  structuredData: [
    createCopperServiceSchema(),
    createItemListSchema('Copper additive manufacturing project routes', [
      {
        name: 'Copper AM capabilities',
        description: 'Materials, build envelope, finishing, inspection, and quotation scope.',
        url: '/capabilities/',
      },
      {
        name: 'Copper 3D printing applications',
        description: 'Cold plates, heat sinks, electrical, RF, semiconductor, and tooling applications.',
        url: '/applications/',
      },
      {
        name: 'Copper AM materials',
        description: 'Pure copper, CuCrZr, CuCr1Zr, and high-temperature copper alloy routes.',
        url: '/materials/',
      },
      {
        name: 'Copper AM RFQ',
        description: 'CAD, drawings, quantity, operating requirements, finishing, and inspection inputs.',
        url: '/rfq/',
      },
    ]),
  ],
};

const applicationLinks = [
  {
    title: 'Cold plates and heat exchangers',
    description: 'Internal channels, manifolds, sealing faces, pressure, cleaning, and leak testing.',
    href: '/copper-cold-plates/',
  },
  {
    title: 'Heat sinks and thermal hardware',
    description: 'Dense fins, compact heat paths, interface machining, airflow, and validation.',
    href: '/copper-heat-sinks/',
  },
  {
    title: 'Electrical, RF, and semiconductor parts',
    description: 'Busbars, induction coils, waveguides, vacuum hardware, and precision thermal components.',
    href: '/applications/',
  },
];
---

<Layout metadata={metadata}>
  <section class="relative min-h-[500px] overflow-hidden border-b border-page-border bg-surface sm:min-h-[600px]">
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-44 sm:inset-y-0 sm:left-auto sm:h-full sm:w-[46%]">
      <Image
        src={heroImage}
        alt="Pure copper and CuCrZr additive manufacturing parts"
        class="h-full w-full object-contain object-bottom sm:object-right"
        widths={[640, 960, 1280]}
        sizes="(max-width: 639px) 100vw, 46vw"
        width={1200}
        height={675}
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="relative z-10 mx-auto max-w-5xl px-4 pb-40 pt-12 sm:px-6 sm:pb-20 sm:pt-24">
      <div class="max-w-[32rem]">
        <p class="text-sm font-semibold text-primary">COPPER 3DP</p>
        <h1 class="mt-4 font-heading text-4xl font-bold leading-[1.08] text-heading sm:text-5xl lg:text-6xl">
          Copper 3D printing for functional parts
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-8 text-muted sm:text-xl">
          Pure copper and CuCrZr LPBF project review for thermal, electrical, RF, vacuum, and semiconductor hardware.
          Send the part, quantity, and requirements; we will evaluate a suitable manufacturing route and quote.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button
            variant="primary"
            text="Send CAD by email"
            href={rfqEmailHref}
            icon="tabler:mail"
            class="w-full justify-center px-5 py-3 sm:w-auto"
          />
          <Button
            variant="secondary"
            text="WhatsApp"
            href={whatsappHref}
            target="_blank"
            icon="tabler:brand-whatsapp"
            class="w-full justify-center px-5 py-3 sm:w-auto"
            data-aw-instant-contact-link
            data-aw-contact-channel="whatsapp"
          />
        </div>
        <p class="mt-5 text-sm leading-6 text-muted">
          Operated by Suzhou Como Precision Materials Co., Ltd. · <a
            class="font-medium text-heading underline underline-offset-4 hover:text-link"
            href="/capabilities/">Review capabilities</a
          >
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-page-border bg-page">
    <div
      class="mx-auto grid max-w-5xl divide-y divide-page-border px-4 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-6"
    >
      <div class="py-6 sm:pr-8">
        <p class="font-semibold text-heading">Materials</p>
        <p class="mt-1 text-sm leading-6 text-muted">
          Pure copper, CuCrZr, CuCr1Zr, and project-specific alloy review.
        </p>
      </div>
      <div class="py-6 sm:px-8">
        <p class="font-semibold text-heading">Manufacturing scope</p>
        <p class="mt-1 text-sm leading-6 text-muted">
          LPBF, heat treatment, machining, finishing, cleaning, and inspection coordination.
        </p>
      </div>
      <div class="py-6 sm:pl-8">
        <p class="font-semibold text-heading">Best-fit geometry</p>
        <p class="mt-1 text-sm leading-6 text-muted">
          Internal channels, integrated thermal paths, compact routing, and consolidated assemblies.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-page py-14 sm:py-20">
    <div class="mx-auto grid max-w-5xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.86fr_1.14fr] lg:gap-16">
      <div>
        <p class="text-sm font-semibold text-primary">What we review</p>
        <h2 class="mt-3 font-heading text-3xl font-bold leading-tight text-heading sm:text-4xl">
          Parts where copper and geometry must work together
        </h2>
        <p class="mt-5 text-base leading-7 text-muted">
          Copper AM is most useful when conductivity alone is not enough: the design also needs hidden flow paths, fewer
          joints, compact packaging, or geometry that stock material cannot provide efficiently.
        </p>
        <div class="mt-8 overflow-hidden rounded-md border border-page-border bg-surface">
          <Image
            src={applicationImage}
            alt="Copper additive manufactured cold plate prototype on an engineering validation bench"
            class="aspect-[16/10] w-full object-cover"
            widths={[480, 720, 960]}
            sizes="(max-width: 1023px) calc(100vw - 2rem), 360px"
            width={900}
            height={563}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <div class="border-t border-page-border">
        {
          applicationLinks.map((item) => (
            <a
              href={item.href}
              class="group grid gap-3 border-b border-page-border py-7 sm:grid-cols-[1fr_auto] sm:items-center"
            >
              <span>
                <span class="block font-heading text-xl font-semibold text-heading group-hover:text-link">
                  {item.title}
                </span>
                <span class="mt-2 block text-sm leading-6 text-muted">{item.description}</span>
              </span>
              <Icon name="tabler:arrow-right" class="h-5 w-5 text-muted group-hover:text-link" />
            </a>
          ))
        }
        <a class="mt-7 inline-flex items-center gap-2 font-semibold text-link hover:underline" href="/applications/">
          View all application routes
          <Icon name="tabler:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <section class="border-y border-page-border bg-surface py-14 sm:py-18">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <p class="text-sm font-semibold text-primary">Quotation input</p>
          <h2 class="mt-3 font-heading text-3xl font-bold leading-tight text-heading">A useful RFQ can be short</h2>
        </div>
        <ol class="grid gap-x-10 gap-y-7 sm:grid-cols-2">
          <li>
            <span class="text-sm font-semibold text-primary">01</span>
            <h3 class="mt-2 font-semibold text-heading">CAD and drawing</h3>
            <p class="mt-1 text-sm leading-6 text-muted">
              STEP or native CAD, dimensions, ports, threads, datums, and critical surfaces.
            </p>
          </li>
          <li>
            <span class="text-sm font-semibold text-primary">02</span>
            <h3 class="mt-2 font-semibold text-heading">Quantity and timing</h3>
            <p class="mt-1 text-sm leading-6 text-muted">
              Prototype quantity, expected batch size, and target delivery date.
            </p>
          </li>
          <li>
            <span class="text-sm font-semibold text-primary">03</span>
            <h3 class="mt-2 font-semibold text-heading">Operating requirement</h3>
            <p class="mt-1 text-sm leading-6 text-muted">
              Heat load, pressure, current, RF band, vacuum, temperature, or service environment.
            </p>
          </li>
          <li>
            <span class="text-sm font-semibold text-primary">04</span>
            <h3 class="mt-2 font-semibold text-heading">Acceptance requirement</h3>
            <p class="mt-1 text-sm leading-6 text-muted">
              Machining, surface finish, cleaning, CT, leak, flow, pressure, or material evidence.
            </p>
          </li>
        </ol>
      </div>
      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-page-border pt-7">
        <a class="font-semibold text-link hover:underline" href="/rfq/">View RFQ checklist</a>
        <a class="font-semibold text-link hover:underline" href="/materials/">Compare copper materials</a>
        <a class="font-semibold text-link hover:underline" href="/category/EngineeringGuide/">Engineering library</a>
      </div>
    </div>
  </section>

  <section class="bg-page py-14 sm:py-18">
    <div class="mx-auto flex max-w-5xl flex-col gap-7 px-4 sm:px-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold text-primary">Start with the part</p>
        <h2 class="mt-3 font-heading text-3xl font-bold leading-tight text-heading sm:text-4xl">
          Send your drawing and the requirement that matters most
        </h2>
        <p class="mt-4 text-base leading-7 text-muted">
          We will review manufacturability, material route, post-processing, inspection scope, and the information
          needed for a practical quotation.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button
          variant="primary"
          text={rfqEmail}
          href={rfqEmailHref}
          icon="tabler:mail"
          class="justify-center px-5 py-3"
        />
        <Button variant="secondary" text="Contact options" href="/contact/" class="justify-center px-5 py-3" />
      </div>
    </div>
  </section>
</Layout>
