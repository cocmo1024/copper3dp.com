---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import RfqForm from '~/components/forms/RfqForm.astro';
import Button from '~/components/ui/Button.astro';
import heroImage from '~/assets/images/copper/hero-copper-parts-transparent.webp';
import partsImage from '~/assets/images/partner/bj-tech/copper-am-reference-parts.webp';
import honeycombImage from '~/assets/images/partner/bj-tech/copper-honeycomb-reference.webp';
import coilsImage from '~/assets/images/partner/bj-tech/copper-induction-coils-reference.webp';
import nozzleImage from '~/assets/images/partner/bj-tech/copper-nozzle-reference.webp';
import videoPoster from '~/assets/images/partner/bj-tech/copper-am-video-poster.webp';
import pureCopperPowderImage from '~/assets/images/partner/bj-tech/pure-copper-powder.webp';
import cuCrNbPowderImage from '~/assets/images/partner/bj-tech/cucrnb-powder.webp';
import cuCrZrPowderImage from '~/assets/images/partner/bj-tech/cucrzr-powder.webp';
import compactPlatformImage from '~/assets/images/partner/bj-tech/equipment/copper-am-compact-100-platform.webp';
import precisionPlatformImage from '~/assets/images/partner/bj-tech/equipment/copper-am-precision-160-platform.webp';
import midFormatPlatformImage from '~/assets/images/partner/bj-tech/equipment/copper-am-mid-format-350-platform.webp';
import multiLaserPlatformImage from '~/assets/images/partner/bj-tech/equipment/copper-am-multi-laser-400-platform.webp';
import largeFormatPlatformImage from '~/assets/images/partner/bj-tech/equipment/copper-am-large-format-660-platform.webp';
import thermalFlowStudyImage from '~/assets/images/partner/blt/thermal-fluid-topology-flow-study.webp';
import thermalReconstructionStudyImage from '~/assets/images/partner/blt/thermal-fluid-topology-reconstruction-study.webp';
import thermalPhysicalPrintStudyImage from '~/assets/images/partner/blt/thermal-topology-physical-print-study.webp';
import { createCopperServiceSchema, createItemListSchema } from '~/utils/structured-data';

const whatsappHref =
  'https://wa.me/8615301541312?text=Hello%2C%20I%20would%20like%20to%20discuss%20a%20copper%203D%20printing%20project.';

const metadata = {
  title: 'Copper 3D Printing Service | Pure Copper & CuCrZr Parts',
  ignoreTitleTemplate: true,
  description:
    'Copper 3D printing service with thermal design support for pure copper, CuCrZr, and CuCr1Zr parts. Green-laser LPBF, machining, inspection, and CAD quotation.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/copper/hero-copper-parts-transparent.webp',
        width: 2048,
        height: 1152,
        alt: 'Pure copper and copper alloy additive manufacturing parts',
      },
    ],
    type: 'website',
  },
  structuredData: [
    createCopperServiceSchema(),
    createItemListSchema('Copper additive manufacturing service scope', [
      {
        name: 'Copper AM engineering and thermal design support',
        description:
          'Thermal requirement review, cooling concept development, DfAM, finishing, and acceptance planning.',
        url: '/#thermal-design-support',
      },
      {
        name: 'Pure copper 3D printing',
        description: 'Green-laser LPBF production for high-conductivity thermal and electrical parts.',
        url: '/pure-copper-3d-printing/',
      },
      {
        name: 'CuCrZr 3D printing',
        description: 'Copper alloy production for parts requiring conductivity with greater mechanical strength.',
        url: '/cucrzr-3d-printing/',
      },
      {
        name: 'Copper AM quotation',
        description: 'Secure submission of CAD, quantity, operating requirements, finishing, and inspection scope.',
        url: '/rfq/',
      },
    ]),
  ],
};

const serviceScope = [
  {
    title: 'Engineering and DfAM',
    description:
      'Review geometry, internal channels, material route, supports, powder removal, datums, and acceptance risk.',
    icon: 'tabler:ruler-measure',
  },
  {
    title: 'Green-laser LPBF',
    description: 'Produce commercially pure copper and copper alloy parts on a platform matched to the geometry.',
    icon: 'tabler:layers-subtract',
  },
  {
    title: 'Finishing and machining',
    description: 'Define heat treatment, support removal, CNC features, sealing faces, threads, polishing, or plating.',
    icon: 'tabler:tool',
  },
  {
    title: 'Inspection and delivery',
    description: 'Agree dimensional, CT, pressure, leak, flow, conductivity, surface, and documentation requirements.',
    icon: 'tabler:microscope',
  },
];

const applicationCapabilities = [
  {
    title: 'Thermal management',
    description: 'Cold plates, compact heat exchangers, heat sinks, cooling blocks, and integrated manifolds.',
    icon: 'tabler:temperature',
  },
  {
    title: 'Semiconductor cooling',
    description: 'Cooling plates, heat spreaders, compact manifolds, and hardware for power electronics.',
    icon: 'tabler:cpu',
  },
  {
    title: 'Electrical and induction',
    description: 'Induction coils, busbars, electrodes, shaped current paths, and high-current components.',
    icon: 'tabler:bolt',
  },
  {
    title: 'RF and vacuum',
    description: 'Waveguides, RF cavities, conductive structures, and vacuum-facing copper hardware.',
    icon: 'tabler:wave-sine',
  },
  {
    title: 'Flow and nozzle hardware',
    description: 'Nozzles, injectors, manifolds, flow distributors, and parts with integral cooling passages.',
    icon: 'tabler:droplet',
  },
  {
    title: 'Tooling and high-heat hardware',
    description: 'Conformal-cooling inserts, thermal tooling, and copper-alloy structures for demanding environments.',
    icon: 'tabler:flame',
  },
];

const materialRoutes = [
  {
    name: 'Commercially pure copper',
    description: 'Selected when thermal or electrical conductivity is the primary design driver.',
    image: pureCopperPowderImage,
    alt: 'Commercially pure copper powder used as LPBF process feedstock',
  },
  {
    name: 'CuCrZr / CuCr1Zr',
    description: 'Selected when conductivity must be balanced with strength and thermal stability.',
    image: cuCrZrPowderImage,
    alt: 'CuCrZr copper alloy powder used as LPBF process feedstock',
  },
  {
    name: 'CuCrNb',
    description: 'Assessed for application-specific copper alloy and elevated-temperature requirements.',
    image: cuCrNbPowderImage,
    alt: 'CuCrNb copper alloy powder used as LPBF process feedstock',
  },
];

const thermalDesignSteps = [
  {
    number: '01',
    title: 'Define the conditions',
    description:
      'Map heat sources, duty cycle, temperature limits, coolant, flow or pressure limits, envelope, and interfaces.',
  },
  {
    number: '02',
    title: 'Compare architectures',
    description:
      'Assess channels, fins or microchannels, impingement, manifolds, and topology-led structures against the constraints.',
  },
  {
    number: '03',
    title: 'Iterate the design',
    description:
      'Balance thermal response, uniformity, pressure drop, strength, powder removal, machining, and inspection access.',
  },
  {
    number: '04',
    title: 'Prepare validation',
    description:
      'Define the agreed CAD and drawing scope, manufacturing route, prototype plan, and included simulation or test evidence.',
  },
];

const thermalDesignInputs = [
  'Heat load, source map, and duty cycle',
  'Temperature or thermal-resistance target',
  'Coolant, inlet conditions, flow, and pressure limits',
  'Envelope, ports, interfaces, and working pressure',
  'Material preference, quantity, and validation needs',
];

// Reference-study images were extracted from the user-supplied BLT thermal-management deck dated 2026-03-31.
const thermalDesignEvidence = [
  {
    image: thermalFlowStudyImage,
    imageClass: 'bg-black object-contain p-3',
    alt: 'Thermal-fluid simulation showing flow distribution through a topology-led cold-plate channel network',
    label: 'Reference study | flow field',
    title: 'Screen the flow architecture',
    description:
      'A topology-led path is a concept, not a guarantee. Compare flow coverage, local velocity, and pressure loss under the agreed coolant and boundary conditions.',
  },
  {
    image: thermalReconstructionStudyImage,
    imageClass: 'bg-white object-contain p-3',
    alt: 'Two reconstructed topology-optimized cold-plate channel layouts with inlet and outlet arrows',
    label: 'Reference study | model reconstruction',
    title: 'Rebuild usable channel geometry',
    description:
      'Convert optimization output into continuous passages with practical walls, powder exits, port transitions, machining stock, and inspection access.',
  },
  {
    image: thermalPhysicalPrintStudyImage,
    imageClass: 'object-cover',
    alt: 'Physical prints of reconstructed topology-optimized cold-plate channel layouts from the supplied reference study',
    label: 'Reference study | physical print',
    title: 'Plan manufacturing evidence',
    description:
      'Use the physical build to review feature continuity, channel access, edge conditions, cleaning or powder removal, and the dimensional, flow, leak, or thermal checks needed before the design is frozen.',
  },
];

const productionEnvelopes = [
  {
    label: 'Compact',
    value: 'Ø100 × 100 mm',
    image: compactPlatformImage,
    alt: 'Representative compact green-laser LPBF platform for the Ø100 × 100 mm build class',
  },
  {
    label: 'Precision',
    value: '160 × 160 × 200 mm',
    image: precisionPlatformImage,
    alt: 'Representative precision green-laser LPBF platform for the 160 × 160 × 200 mm build class',
  },
  {
    label: 'Mid-format',
    value: '350 × 350 × 500 mm',
    image: midFormatPlatformImage,
    alt: 'Representative mid-format green-laser LPBF platform for the 350 × 350 × 500 mm build class',
  },
  {
    label: 'Multi-laser',
    value: '400 × 400 × 400 mm',
    image: multiLaserPlatformImage,
    alt: 'Representative multi-laser LPBF platform for the 400 × 400 × 400 mm build class',
  },
  {
    label: 'Large-format',
    value: '660 × 660 × 1300 mm',
    image: largeFormatPlatformImage,
    alt: 'Representative large-format green-laser LPBF platform for the 660 × 660 × 1300 mm build class',
  },
];

const processSteps = [
  {
    number: '01',
    title: 'Define the requirement',
    description:
      'Send CAD or, for thermal-design work, the governing operating requirements, envelope, interfaces, quantity, and acceptance needs.',
  },
  {
    number: '02',
    title: 'Lock the route',
    description:
      'For scoped thermal-design projects, we develop and iterate cooling geometry before fixing the material, DfAM, finishing, and test route.',
  },
  {
    number: '03',
    title: 'Print and finish',
    description:
      'The part moves through green-laser LPBF, support removal, heat treatment, CNC, and specified finishing.',
  },
  {
    number: '04',
    title: 'Inspect and deliver',
    description:
      'Inspection evidence is produced against the agreed scope before packaging and international delivery.',
  },
];

const applicationExamples = [
  {
    image: honeycombImage,
    alt: 'Copper honeycomb and lattice heat-exchange geometry',
    title: 'Heat-exchange structures',
    description: 'Dense surface area, compact flow paths, and monolithic thermal cores.',
    className: 'lg:col-span-7',
  },
  {
    image: coilsImage,
    alt: 'Additively manufactured copper induction coils and conductive paths',
    title: 'Induction and conductive paths',
    description: 'Integrated cooling, shaped current paths, and repeatable coil geometry.',
    className: 'lg:col-span-5',
  },
  {
    image: nozzleImage,
    alt: 'Additively manufactured copper nozzle with fine external flow features',
    title: 'Nozzles and flow hardware',
    description: 'Internal passages, consolidated bodies, and heat-flux-focused geometry.',
    className: 'lg:col-span-5',
  },
  {
    image: partsImage,
    alt: 'Copper additive manufacturing parts with fins, lattices, channels, and thin walls',
    title: 'Fins, lattices, and integrated features',
    description: 'Geometry that combines thermal, structural, and fluid functions in fewer pieces.',
    className: 'lg:col-span-7',
  },
];
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden border-b border-page-border bg-surface">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_72%_38%,rgba(194,104,58,0.16),transparent_34%),linear-gradient(to_bottom,transparent,rgba(0,0,0,0.08))]"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative mx-auto grid min-h-[650px] max-w-5xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[0.96fr_1.04fr] lg:gap-14"
    >
      <div class="max-w-[37rem]">
        <p class="flex items-center gap-3 text-xs font-semibold text-accent sm:text-sm">
          <span class="h-2 w-2 rounded-full bg-accent shadow-[0_0_18px_rgba(194,104,58,0.9)]"></span>
          Copper additive manufacturing | Suzhou, China
        </p>
        <h1 class="mt-5 font-heading text-4xl font-bold leading-[1.08] tracking-[-0.025em] text-heading sm:text-5xl">
          Copper 3D printing for functional parts
        </h1>
        <p class="mt-7 max-w-xl text-base leading-7 text-muted sm:text-lg">
          We manufacture pure copper and copper-alloy parts from your CAD. Design-stage cooling projects can also begin
          with defined thermal and fluid requirements. Send the available package for an engineering review and scoped
          quotation.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button
            variant="primary"
            text="Send CAD or thermal brief"
            href="#rfq-form"
            icon="tabler:file-upload"
            class="w-full justify-center px-5 py-3 sm:w-auto"
            data-aw-cta-location="homepage_hero"
          />
          <Button
            variant="secondary"
            text="Discuss on WhatsApp"
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            icon="tabler:brand-whatsapp"
            class="w-full justify-center px-5 py-3 sm:w-auto"
            data-aw-instant-contact-link
            data-aw-contact-channel="whatsapp"
            data-aw-cta-location="homepage_hero"
          />
        </div>
        <p class="mt-3 text-sm leading-6 text-muted">
          Prefer email?
          <button
            class="font-semibold text-link hover:underline"
            type="button"
            data-aw-copy-email="info@szcomo.com"
            data-aw-cta-location="homepage_hero"
          >
            Copy info@szcomo.com
          </button>
        </p>

        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm leading-6 text-muted">
          <span class="inline-flex items-center gap-2">
            <Icon name="tabler:check" class="h-4 w-4 text-accent" />
            Pure copper and copper alloys
          </span>
          <span class="inline-flex items-center gap-2">
            <Icon name="tabler:check" class="h-4 w-4 text-accent" />
            Prototype and production
          </span>
          <span class="inline-flex items-center gap-2">
            <Icon name="tabler:check" class="h-4 w-4 text-accent" />
            Finished-part delivery
          </span>
        </div>
      </div>

      <div class="relative">
        <div
          class="relative overflow-hidden rounded-xl border border-page-border bg-page/70 p-4 shadow-[0_28px_80px_rgba(0,0,0,0.28)] sm:p-7"
        >
          <div
            class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:32px_32px]"
            aria-hidden="true"
          >
          </div>
          <Image
            src={heroImage}
            alt="Pure copper and copper alloy additive manufacturing parts"
            class="relative h-auto w-full object-contain"
            style="object-fit: contain;"
            widths={[480, 640, 960, 1280]}
            sizes="(max-width: 1023px) calc(100vw - 3rem), 480px"
            width={2048}
            height={1152}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>

        <div
          class="relative -mt-6 ml-4 grid max-w-[92%] grid-cols-3 divide-x divide-page-border rounded-md border border-page-border bg-surface/95 shadow-panel backdrop-blur sm:ml-8"
        >
          <div class="px-3 py-4 sm:px-4">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-muted">Process</p>
            <p class="mt-1 text-sm font-semibold leading-5 text-heading">Green-laser LPBF</p>
          </div>
          <div class="px-3 py-4 sm:px-4">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-muted">Materials</p>
            <p class="mt-1 text-sm font-semibold leading-5 text-heading">Pure Cu · CuCrZr</p>
          </div>
          <div class="px-3 py-4 sm:px-4">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-muted">Output</p>
            <p class="mt-1 text-sm font-semibold leading-5 text-heading">Inspected parts</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-page-border bg-page">
    <div
      class="mx-auto grid max-w-5xl divide-y divide-page-border px-4 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-6"
    >
      <div class="py-6 sm:pr-8">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">Service</p>
        <p class="mt-2 font-semibold text-heading">Copper AM production</p>
      </div>
      <div class="py-6 sm:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">Scope</p>
        <p class="mt-2 font-semibold text-heading">Print · machine · inspect</p>
      </div>
      <div class="py-6 sm:pl-8">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">Start</p>
        <p class="mt-2 font-semibold text-heading">CAD or thermal brief review</p>
      </div>
    </div>
  </section>

  <section class="bg-page py-16 sm:py-24" aria-labelledby="who-we-are">
    <div class="mx-auto grid max-w-5xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.82fr_1.18fr] lg:gap-16">
      <div>
        <p class="text-sm font-semibold text-accent">01 | Who we are</p>
        <h2
          id="who-we-are"
          class="mt-3 scroll-mt-24 font-heading text-3xl font-bold leading-tight tracking-[-0.02em] text-heading sm:text-4xl"
        >
          A copper AM service built around finished parts
        </h2>
        <p class="mt-6 text-base leading-7 text-muted">
          COPPER 3DP is the copper additive manufacturing service of Suzhou Como Precision Materials Co., Ltd. We review
          the drawing, manufacture the part, complete downstream operations, and supply the agreed inspection evidence.
        </p>
        <p class="mt-4 text-base leading-7 text-muted">
          The engineering discussion stays focused on the part: function, geometry, material state, downstream
          operations, acceptance evidence, quantity, and timing.
        </p>
        <a class="mt-7 inline-flex items-center gap-2 font-semibold text-link hover:underline" href="#rfq-form">
          Send your drawing
          <Icon name="tabler:arrow-down" class="h-4 w-4" />
        </a>
      </div>

      <div class="grid border-t border-page-border sm:grid-cols-2">
        {
          serviceScope.map((item) => (
            <article class="border-b border-page-border py-7 sm:odd:pr-7 sm:even:border-l sm:even:pl-7">
              <div class="flex h-10 w-10 items-center justify-center rounded-md border border-page-border bg-surface">
                <Icon name={item.icon} class="h-5 w-5 text-accent" />
              </div>
              <h3 class="mt-5 font-heading text-lg font-semibold text-heading">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-page-border bg-surface py-16 sm:py-24" aria-labelledby="what-we-print">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid gap-7 lg:grid-cols-[0.82fr_1.18fr] lg:items-end lg:gap-16">
        <div>
          <p class="text-sm font-semibold text-accent">02 | What we make</p>
          <h2
            id="what-we-print"
            class="mt-3 scroll-mt-24 font-heading text-3xl font-bold leading-tight tracking-[-0.02em] text-heading sm:text-4xl"
          >
            Functional copper parts for heat, current, flow, and tooling
          </h2>
        </div>
        <p class="text-base leading-7 text-muted">
          We manufacture prototypes and production parts when internal channels, compact heat-transfer area, shaped
          current paths, or part consolidation make conventional fabrication inefficient.
        </p>
      </div>

      <div
        class="mt-12 grid gap-px overflow-hidden rounded-md border border-page-border bg-page-border sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          applicationCapabilities.map((item) => (
            <article class="bg-page p-6 sm:p-8">
              <span class="flex h-11 w-11 items-center justify-center rounded-md border border-page-border bg-surface">
                <Icon name={item.icon} class="h-5 w-5 text-accent" />
              </span>
              <h3 class="mt-7 font-heading text-xl font-semibold text-heading">{item.title}</h3>
              <p class="mt-3 max-w-md text-sm leading-6 text-muted">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-page-border bg-page py-16 sm:py-24" aria-labelledby="thermal-design-support">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid gap-7 lg:grid-cols-[0.82fr_1.18fr] lg:items-end lg:gap-16">
        <div>
          <p class="text-sm font-semibold text-accent">03 | Thermal design support</p>
          <h2
            id="thermal-design-support"
            class="mt-3 scroll-mt-24 font-heading text-3xl font-bold leading-tight tracking-[-0.02em] text-heading sm:text-4xl"
          >
            From thermal requirements to manufacturable copper cooling hardware
          </h2>
        </div>
        <div class="space-y-4 text-base leading-7 text-muted">
          <p>
            A project can start with finished CAD or with heat load, temperature limits, coolant, flow or pressure-drop
            targets, available envelope, and interfaces. We turn those inputs into a scoped design, manufacturing, and
            validation route.
          </p>
          <p>
            The selected geometry is project-specific. More surface area does not automatically mean better cooling once
            pressure drop, flow distribution, cleanability, and printability are considered.
          </p>
        </div>
      </div>

      <ol class="mt-12 grid border-y border-page-border sm:grid-cols-2 lg:grid-cols-4">
        {
          thermalDesignSteps.map((item) => (
            <li class="border-b border-page-border py-7 sm:px-6 sm:odd:pl-0 sm:even:border-l lg:border-b-0 lg:border-l lg:px-6 lg:[&:nth-child(3)]:!pl-6 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0">
              <span class="font-mono text-sm font-semibold text-accent">{item.number}</span>
              <h3 class="mt-4 font-heading text-lg font-semibold text-heading">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.description}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 border-t border-page-border pt-8">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
            Architecture, reconstruction, and evidence
          </p>
          <h3 class="mt-3 font-heading text-2xl font-bold text-heading">
            Three gates before the cooling geometry is frozen
          </h3>
          <p class="mt-3 text-sm leading-6 text-muted">
            Metal AM expands the available surface, fin, and channel design space. The value is realized only when the
            thermal concept can be simulated under defined conditions, rebuilt as manufacturable geometry, and tied to
            an agreed validation plan.
          </p>
        </div>

        <div class="mt-8 grid gap-7 lg:grid-cols-3">
          {
            thermalDesignEvidence.map((item) => (
              <figure class="group border-t border-page-border pt-5">
                <div class="overflow-hidden rounded-lg border border-page-border bg-surface">
                  <Image
                    src={item.image}
                    alt={item.alt}
                    class={`aspect-[16/10] w-full ${item.imageClass}`}
                    widths={[480, 720, 960]}
                    sizes="(max-width: 1023px) calc(100vw - 2rem), 320px"
                    width={960}
                    height={600}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption class="mt-5">
                  <p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent">{item.label}</p>
