  <script>
    const youtubeFacade = document.querySelector('[data-youtube-facade]');

    if (youtubeFacade instanceof HTMLAnchorElement) {
      youtubeFacade.addEventListener(
        'click',
        (event) => {
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          const embedUrl = youtubeFacade.dataset.youtubeEmbed;
          if (!embedUrl) return;

          event.preventDefault();

          const iframe = document.createElement('iframe');
          iframe.className = 'aspect-video w-full';
          iframe.src = embedUrl;
          iframe.title = 'Copper 3D Printing with Green-Laser LPBF — Process and Parts';
          iframe.allow =
            'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          iframe.referrerPolicy = 'strict-origin-when-cross-origin';
          iframe.allowFullscreen = true;

          youtubeFacade.replaceWith(iframe);
          iframe.focus();
        },
        { once: true }
      );
    }
  </script>
