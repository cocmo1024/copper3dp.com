---
import KnowledgePage from '~/components/knowledge/KnowledgePage.astro';
import { decisionClusters, type DecisionCluster } from '~/data/decision-clusters';
import { createBreadcrumbSchema, createItemListSchema } from '~/utils/structured-data';

export function getStaticPaths() {
  return decisionClusters.map((cluster) => ({ params: { cluster: cluster.slug }, props: { cluster } }));
}

interface Props {
  cluster: DecisionCluster;
}

const { cluster } = Astro.props;
const canonicalPath = `/knowledge/decision-guides/${cluster.slug}/`;
const canonical = `https://copper3dp.com${canonicalPath}`;
const metadata = {
  title: `${cluster.name} Decision Center | COPPER 3DP`,
  ignoreTitleTemplate: true,
  description: cluster.description,
  canonical,
  structuredData: [
    createBreadcrumbSchema([
      { name: 'Home', item: '/' },
      { name: 'Knowledge Center', item: '/knowledge/' },
      { name: 'Decision Guides', item: '/knowledge/decision-guides/' },
      { name: cluster.shortName, item: canonicalPath },
    ]),
    createItemListSchema(
      `${cluster.name} decision guides`,
      cluster.guides.map((guide) => ({ name: guide.title, description: guide.description, url: guide.href }))
    ),
  ],
};
---

<KnowledgePage
  metadata={metadata}
  currentPath="/knowledge/decision-guides/"
  eyebrow={cluster.eyebrow}
  title={cluster.name}
  introduction={cluster.description}
  stats={[
    { value: cluster.guides.length, label: 'Focused guides' },
    { value: cluster.questions.length, label: 'Decision gates' },
    { value: 'Finished part', label: 'Evidence level' },
    { value: 'Project-specific', label: 'Acceptance' },
  ]}
>
  <section class="py-12 sm:py-14" aria-labelledby="cluster-verdict">
    <div class="mx-auto grid max-w-5xl gap-8 px-4 sm:px-6 md:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="text-sm font-semibold text-primary">Decision rule</p>
        <h2 id="cluster-verdict" class="mt-2 font-heading text-3xl font-bold text-heading">
          What this cluster should decide
        </h2>
      </div>
      <div class="space-y-5 leading-7 text-muted">
        <p class="text-lg text-default">{cluster.decision}</p>
        <p class="border-l-2 border-primary pl-4">{cluster.boundary}</p>
        <p class="text-sm">
          Primary users: <span class="font-semibold text-default">{cluster.audience}</span>
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-page-border bg-surface py-12 sm:py-14" aria-labelledby="cluster-gates">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <p class="text-sm font-semibold text-primary">Decision gates</p>
      <h2 id="cluster-gates" class="mt-2 font-heading text-3xl font-bold text-heading">
        Close these questions before quotation
      </h2>
      <div class="mt-8 grid gap-px overflow-hidden border-y border-page-border bg-page-border md:grid-cols-2">
        {
          cluster.questions.map((item, index) => (
            <div class="bg-page p-6">
              <p class="text-xs font-semibold text-primary">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="mt-2 font-heading text-lg font-semibold text-heading">{item.title}</h3>
              <p class="mt-2 leading-7 text-muted">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-14" aria-labelledby="cluster-guides">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <p class="text-sm font-semibold text-primary">Independent decision pages</p>
      <h2 id="cluster-guides" class="mt-2 font-heading text-3xl font-bold text-heading">
        Use the guide that matches the unresolved requirement
      </h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          cluster.guides.map((guide) => (
            <a class="group border border-page-border bg-page p-6 hover:border-primary/60" href={guide.href}>
              <p class="text-xs font-semibold text-primary">{guide.topicId}</p>
              <h3 class="mt-2 font-heading text-xl font-semibold text-heading group-hover:text-link">{guide.title}</h3>
              <p class="mt-3 leading-7 text-muted">{guide.description}</p>
              <p class="mt-5 text-sm font-semibold text-link">Read decision guide</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-page-border bg-surface py-12 sm:py-14" aria-labelledby="cluster-related">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <p class="text-sm font-semibold text-primary">Supporting paths</p>
      <h2 id="cluster-related" class="mt-2 font-heading text-3xl font-bold text-heading">
        Continue to service, evidence, and validation pages
      </h2>
      <div class="mt-8 grid border-t border-page-border md:grid-cols-2">
        {
          cluster.related.map((item) => (
            <a
              class="group border-b border-page-border py-5 md:odd:pr-8 md:even:border-l md:even:pl-8"
              href={item.href}
            >
              <h3 class="font-heading text-lg font-semibold text-heading group-hover:text-link">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</KnowledgePage>
