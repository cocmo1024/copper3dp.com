---
import CallToAction from '~/components/widgets/CallToAction.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import SplitShowcase from '~/components/widgets/SplitShowcase.astro';
import Layout from '~/layouts/PageLayout.astro';
import {
  createBreadcrumbSchema,
  createCopperApplicationServiceSchema,
  createFaqSchema,
  createItemListSchema,
} from '~/utils/structured-data';

const sectionContainerClass = 'py-10 md:py-12 lg:py-14';
const whatsappHref =
  'https://wa.me/8615301541312?text=Hello%2C%20I%20would%20like%20to%20discuss%20a%20custom%20copper%20heat%20sink%20RFQ.';

const heatSinkFaqs = [
  {
    title: 'Can you quote a custom copper heatsink from a CAD file?',
    description:
      'Yes, if the CAD and drawing define the geometry, quantity, interface surfaces, mounting method, and thermal target. For a serious quote, include heat load, airflow or coolant conditions, flatness, surface finish, and validation requirements.',
  },
  {
    title: 'When is a 3D printed copper heat sink better than CNC machining?',
    description:
      'LPBF copper AM is most useful when the heat sink needs complex airflow paths, internal channels, integrated mounting, dense features, or geometry that would require many machined or brazed pieces.',
  },
  {
    title: 'When should fabricated copper heat sinks stay conventional?',
    description:
      'Fabricated copper heat sinks are often the better route for simple plates, straight fins, drilled holes, skived geometries, or brazed assemblies where the main value is cost, flatness, or straightforward machining rather than hidden internal geometry.',
  },
  {
    title: 'When should a copper heat sink become a copper cold plate?',
    description:
      'If airflow, fan power, noise, or available volume cannot meet the thermal target, a liquid cold plate may be the better copper thermal hardware route. The RFQ should compare thermal resistance and pressure drop, not only material conductivity.',
  },
  {
    title: 'What causes custom copper heat sinks to miss performance?',
    description:
      'Common causes are weak thermal boundary conditions, poor contact flatness, excessive TIM thickness, fin spacing that starves airflow, blocked internal channels, and acceptance tests that do not match the final assembly.',
  },
  {
    title: 'What if the thermal design is not ready for quotation?',
    description:
      'Start with the heat load, source footprint, maximum component temperature, inlet air or coolant temperature, available space, and mounting constraints. Share the fan curve or coolant flow and pressure budget if known. Mark missing values as open so the review can separate assumptions from confirmed requirements before committing to a fin or channel layout.',
  },
];

const heatSinkShowcases = [
  {
    imagePosition: 'left' as const,
    image: {
      src: '~/assets/images/copper/copper-heat-sinks.webp',
      alt: 'Copper heat sink RFQ review',
    },
    title: 'What to send for a custom copper heat sink quote',
    description:
      'A simple custom copper heatsink drawing can support a basic quotation. Complex thermal parts need enough boundary conditions to avoid quoting a geometry that cannot be accepted later.',
    points: [
      {
        title: 'Geometry and mounting',
        description:
          'Send CAD and drawings for base thickness, fin field, mounting holes, datum faces, contact areas, channels, and machining stock.',
      },
      {
        title: 'Thermal boundary conditions',
        description:
          'Include heat load, target temperature, airflow or coolant, interface material, clamp approach, and available test method if known.',
      },
      {
        title: 'Quantity and acceptance',
        description:
          'State prototype or batch quantity, material preference, flatness, surface finish, inspection, and thermal validation requirements.',
      },
    ],
  },
];

const metadata = {
  title: 'Custom Copper Heat Sinks | 3D Printing & CAD Review',
  ignoreTitleTemplate: true,
  description:
    'Custom copper heat sinks from CAD: review LPBF against CNC, skiving and brazing. Define airflow, machined interfaces and thermal acceptance before quotation.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/copper/copper-heat-sinks.webp',
        width: 1200,
        height: 628,
        alt: '3D printed copper heat sinks',
      },
    ],
    type: 'website',
  },
  structuredData: [
    createBreadcrumbSchema([
      { name: 'Home', item: '/' },
      { name: 'Copper heat sinks', item: '/copper-heat-sinks/' },
    ]),
    createCopperApplicationServiceSchema({
      id: 'copper-heat-sinks',
      name: 'Custom Copper Heat Sink Service',
      serviceType: 'Custom copper heat sink and LPBF copper heat sink additive manufacturing',
      description:
        'Quotation and production coordination for custom copper heat sinks with fin geometry, thermal targets, interface flatness, material selection, post-processing, and test requirements.',
      url: '/copper-heat-sinks/',
      audienceType: 'Thermal, power electronics, RF, aerospace, and purchasing teams',
    }),
    createItemListSchema('Copper heat sink RFQ inputs', [
      {
        name: 'Custom heat sink geometry package',
        description: 'CAD and drawings for base, fins, channels, datum faces, mounting holes, and critical interfaces.',
        url: '/copper-heat-sinks/#rfq-inputs',
      },
      {
        name: 'Thermal requirements',
        description:
          'Heat load, airflow or coolant condition, interface stack-up, target temperature, and test method.',
        url: '/copper-heat-sinks/#rfq-inputs',
      },
      {
        name: 'Acceptance requirements',
        description:
          'Flatness, surface finish, material route, machining, coating, inspection, and thermal validation needs.',
        url: '/copper-heat-sinks/#review-points',
      },
    ]),
    createFaqSchema(heatSinkFaqs),
  ],
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Copper heat sinks"
    title="Custom copper heat sinks, from CAD review to 3D printing"
    subtitle="For OEM and engineering teams developing complex fins, pins, integrated cooling paths, or constrained thermal hardware. Send CAD or a thermal brief; we will compare LPBF copper AM with machining, skiving, and brazing before quoting."
    actions={[
      {
        variant: 'primary',
        text: 'Submit heat sink RFQ',
        href: '/rfq/?project=heat-exchanger#rfq-form',
        icon: 'tabler:file-upload',
      },
      {
        text: 'Discuss on WhatsApp',
        href: whatsappHref,
        target: '_blank',
        rel: 'noopener noreferrer',
        icon: 'tabler:brand-whatsapp',
        'data-aw-instant-contact-link': true,
        'data-aw-contact-channel': 'whatsapp',
      },
    ]}
    image={{
      src: '~/assets/images/copper/hero-copper-parts-transparent.webp',
      alt: 'Copper additive manufacturing parts for heat sink RFQ review',
      class: 'mx-auto w-full',
    }}
  />

  <Features2
    title="When copper AM creates value in a custom heat sink"
    subtitle="Printed copper is useful when the geometry solves a real thermal or packaging constraint. It is not automatically better than CNC, skiving, or brazed copper construction."
    columns={3}
    items={[
      {
        title: 'Dense thermal geometry',
        description:
          'Fins, pins, channels, or hybrid structures can be reviewed when airflow, pressure drop, and cleaning access are realistic.',
        icon: 'tabler:temperature',
      },
      {
        title: 'Integrated cooling paths',
        description:
          'Internal liquid passages or combined heat sink and manifold features can be useful when leak and inspection requirements are clear.',
        icon: 'tabler:droplet',
      },
      {
        title: 'Constrained packaging',
        description:
          'Copper AM may help when thermal surfaces, mounting features, and routing need to fit into a compact envelope.',
        icon: 'tabler:box-seam',
      },
    ]}
  />

  <Features2
    title="Choose the heat sink route before quotation"
    subtitle="The strongest RFQs separate the heat sink function from the manufacturing route. This avoids forcing LPBF onto a part that should be machined, skived, brazed, or converted into a cold plate."
    columns={3}
    items={[
      {
        title: 'CNC, skived, or fabricated copper',
        description:
          'Often better for flat bases, simple fins, drilled holes, rectangular envelopes, and fabricated copper heat sinks where the main value is machining accuracy.',
        icon: 'tabler:tool',
      },
      {
        title: '3D printed copper heat sink',
        description:
          'Worth reviewing for dense pins, curved airflow paths, integrated manifolds, internal passages, unusual mounting, or low-volume thermal hardware.',
        icon: 'tabler:printer',
      },
      {
        title: 'Copper cold plate instead',
        description:
          'When airflow cannot meet the thermal target, the right answer may be a liquid cold plate rather than a more aggressive copper heatsink.',
        icon: 'tabler:droplet',
      },
    ]}
  />

  <Features2
    title="Confirm the production route before issuing the RFQ"
    subtitle="Use the published capability boundary to decide whether the part should stay CNC, skived, fabricated, brazed, or move to LPBF copper AM."
    columns={2}
    classes={{ container: sectionContainerClass }}
    items={[
      {
        title: 'Copper AM capabilities',
        description:
          'Representative green-laser build envelope, material routes, finishing, machining, inspection, and quotation responsibility.',
        icon: 'tabler:settings',
        callToAction: {
          text: 'View capabilities',
          href: '/capabilities/',
        },
      },
      {
        title: 'Heat sink RFQ inputs',
        description:
          'CAD, heat load, airflow or coolant, interface flatness, mounting, material, quantity, finishing, and validation method.',
        icon: 'tabler:clipboard-list',
        callToAction: {
          text: 'View quotation checklist',
          href: '/rfq/',
        },
      },
    ]}
  />

  <SplitShowcase id="rfq-inputs" items={heatSinkShowcases} classes={{ container: sectionContainerClass }} />

  <Features2
    id="review-points"
    title="Decision points before quotation"
    subtitle="Most heat sink surprises come from interface, air-side, coolant-side, or post-processing requirements rather than copper conductivity alone."
    columns={3}
    items={[
      {
        title: 'Fin and channel limits',
        description:
          'Minimum fin thickness, spacing, aspect ratio, support strategy, powder removal, and cleaning access affect feasibility.',
        icon: 'tabler:ruler-measure',
      },
      {
        title: 'Interface control',
        description:
          'Contact flatness, surface finish, clamp load, TIM choice, and machining plan often dominate final thermal resistance.',
        icon: 'tabler:arrows-minimize',
      },
      {
        title: 'Material behavior',
        description:
          'Pure copper, CuCrZr, or GRCop-42 should be reviewed against conductivity, strength, temperature, and heat treatment needs.',
        icon: 'tabler:atom',
      },
      {
        title: 'Airflow or pressure drop',
        description:
          'Share inlet temperature, the fan curve or coolant flow, and the pressure budget. Review the installed flow path and bypass gaps: a free-air fan rating does not establish the flow through dense fins.',
        icon: 'tabler:wind',
      },
      {
        title: 'Post-processing scope',
        description:
          'Machining, polishing, heat treatment, cleaning, coating, and plating requirements should be known before quoting.',
        icon: 'tabler:tools',
      },
      {
        title: 'Validation method',
        description:
          'Agree the heat input, assembly orientation, clamp and interface conditions, sensor locations, and temperature limits. Compare designs at the same operating point, then confirm the selected route in the intended assembly.',
        icon: 'tabler:clipboard-check',
        callToAction: {
          text: 'Plan thermal design validation',
          href: '/thermal-design-validation/#validation-plan',
        },
      },
    ]}
  />

  <Features2
    title="Related engineering guides"
    subtitle="Use these before adding unnecessary requirements to a custom copper heat sink RFQ."
    columns={3}
    items={[
      {
        title: '3D printed copper heat sink feasibility',
        description:
          'Use this before committing to LPBF when fins, pins, internal channels, airflow, finishing, and cost need a go or no-go decision.',
        icon: 'tabler:route',
        callToAction: {
          text: 'Read feasibility guide',
          href: '/posts/EngineeringGuide/3d-printed-copper-heat-sinks-feasibility/',
        },
      },
      {
        title: 'Fin thickness and spacing',
        description:
          'Use this when the design has thin fins, dense channels, powder removal risk, or inspection limits.',
        icon: 'tabler:ruler',
        callToAction: {
          text: 'Read limits',
          href: '/posts/EngineeringGuide/minimum-fin-thickness-spacing-3d-printed-copper-heat-sinks/',
        },
      },
      {
        title: 'Pure copper vs CuCrZr heat sinks',
        description:
          'Compare conductivity, strength, softening behavior, heat treatment, interfaces, and finished-component evidence.',
        icon: 'tabler:atom',
        callToAction: {
          text: 'Compare material routes',
          href: '/posts/EngineeringGuide/pure-copper-vs-cucrzr-high-performance-heat-sinks/',
        },
      },
    ]}
  />

  <FAQs
    title="Custom copper heat sink RFQ questions"
    subtitle="Use these checks before requesting pricing for a copper heatsink, 3D printed copper heat sink, or liquid-cooled thermal part."
    classes={{ container: sectionContainerClass }}
    items={heatSinkFaqs}
  />

  <CallToAction
    classes={{ container: sectionContainerClass }}
    title="Send drawings, quantity, and copper heat sink requirements"
    subtitle="Submit the CAD package and critical thermal requirements. We will compare machining, skiving, brazing, LPBF copper AM, and cold plate options before responding with a quotation or clarification questions."
    actions={[
      {
        variant: 'primary',
        text: 'Submit heat sink RFQ',
        href: '/rfq/?project=heat-exchanger#rfq-form',
        icon: 'tabler:file-upload',
      },
      {
        text: 'Discuss on WhatsApp',
        href: whatsappHref,
        target: '_blank',
        rel: 'noopener noreferrer',
        icon: 'tabler:brand-whatsapp',
        'data-aw-instant-contact-link': true,
        'data-aw-contact-channel': 'whatsapp',
      },
    ]}
  />
</Layout>
