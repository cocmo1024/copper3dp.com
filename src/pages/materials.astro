---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import SplitShowcase from '~/components/widgets/SplitShowcase.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { createBreadcrumbSchema, createItemListSchema } from '~/utils/structured-data';

const sectionContainerClass = 'py-10 md:py-12 lg:py-14';

const materialShowcases = [
  {
    imagePosition: 'left' as const,
    image: {
      src: '~/assets/images/copper/induction-heating-coils.webp',
      alt: 'Copper induction coil material review',
    },
    title: 'Material inputs that support a faster decision',
    description:
      'The same alloy can behave differently depending on wall thickness, heat treatment, machining allowance, inspection scope, and operating environment.',
    points: [
      {
        title: 'Conductivity after processing',
        description:
          'Conductivity targets should be discussed after stress relief, heat treatment, machining, polishing, or plating requirements are known.',
      },
      {
        title: 'Strength and service temperature',
        description:
          'Clamp loads, pressure loads, thermal cycling, and local wall thickness determine whether pure copper is enough.',
      },
      {
        title: 'Inspection and certification',
        description:
          'State whether material certificates, density expectations, CT review, or leak-test requirements are needed.',
      },
    ],
  },
];

const metadata = {
  title: 'Copper AM Materials | Pure Copper, CuCrZr & CuCr1Zr',
  ignoreTitleTemplate: true,
  description:
    'Material selection for LPBF copper AM: pure copper, CuCrZr, CuCr1Zr, and GRCop-42 for thermal, electrical, aerospace, and high-temperature parts.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/copper/high-current-busbars.webp',
        width: 1200,
        height: 628,
        alt: 'Copper additive manufacturing material application parts',
      },
    ],
    type: 'website',
  },
  structuredData: [
    createBreadcrumbSchema([
      { name: 'Home', item: '/' },
      { name: 'Materials', item: '/materials/' },
    ]),
    createItemListSchema('Copper AM material paths', [
      {
        name: 'Pure copper',
        description: 'Best suited to parts where electrical or thermal conductivity is the dominant requirement.',
        url: '/pure-copper-3d-printing/',
      },
      {
        name: 'CuCrZr',
        description: 'Best suited to parts where strength and softening resistance matter alongside conductivity.',
        url: '/cucrzr-3d-printing/',
      },
      {
        name: 'CuCr1Zr',
        description:
          'Relevant when the drawing, standard, supplier data sheet, or qualification route requires a documented copper-chromium-zirconium alloy path.',
        url: '/posts/EngineeringGuide/cucr1zr-copper-alloy-3d-printing-industrial-components/',
      },
      {
        name: 'GRCop-42',
        description:
          'Considered for high-temperature aerospace and thermal hardware where qualification documentation matters.',
        url: '/materials/',
      },
    ]),
  ],
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Materials"
    title="Copper materials for additive manufacturing"
    subtitle="If the alloy is specified, include it with the drawing. If not, send the operating conditions so we can compare pure copper, CuCrZr, CuCr1Zr, or a specialized copper alloy route."
    actions={[
      {
        variant: 'primary',
        text: 'Email material requirements',
        href: 'mailto:info@szcomo.com',
      },
      { text: 'Quotation checklist', href: '/rfq/' },
    ]}
    image={{
      src: '~/assets/images/copper/hero-copper-parts-transparent.webp',
      alt: 'Copper additive manufacturing material review parts',
      class: 'mx-auto w-full',
    }}
  />

  <Features2
    title="Common material paths"
    subtitle="The right route is selected against the function of the part, not by material name alone."
    columns={4}
    items={[
      {
        title: 'Pure copper',
        description:
          'Best suited to parts where electrical or thermal conductivity is dominant, mechanical loads are controlled, and final conductivity matters more than strength.',
        icon: 'tabler:hexagon-letter-c',
      },
      {
        title: 'CuCrZr',
        description:
          'Useful when the part needs more strength, clamp-load stability, or softening resistance while retaining useful conductivity after heat treatment.',
        icon: 'tabler:atom',
      },
      {
        title: 'CuCr1Zr',
        description:
          'Important when a drawing, supplier route, or quality plan requires a documented copper-chromium-zirconium alloy designation and evidence package.',
        icon: 'tabler:file-certificate',
      },
      {
        title: 'GRCop-42',
        description:
          'Reviewed for high-temperature thermal hardware where alloy behavior, heat treatment, and documentation may matter.',
        icon: 'tabler:rocket',
      },
    ]}
  />

  <SplitShowcase items={materialShowcases} classes={{ container: sectionContainerClass }} />

  <Features2
    title="Material decision guides"
    subtitle="Use these guides when material designation alone is not enough to define the finished copper AM part."
    columns={3}
    classes={{ container: sectionContainerClass }}
    items={[
      {
        title: 'Pure copper 3D printing service',
        description:
          'For conductive components, heat spreaders, busbars, and thermal parts where final conductivity evidence matters.',
        icon: 'tabler:hexagon-letter-c',
        callToAction: {
          text: 'View pure copper service',
          href: '/pure-copper-3d-printing/',
        },
      },
      {
        title: 'CuCrZr 3D printing service',
        description:
          'For thermal hardware with clamp loads, threads, pressure boundaries, thin walls, or strength after heat treatment.',
        icon: 'tabler:atom',
        callToAction: {
          text: 'View CuCrZr service',
          href: '/cucrzr-3d-printing/',
        },
      },
      {
        title: 'CuCr1Zr AM',
        description:
          'For industrial drawings, supplier data sheets, or qualification routes that require documented CuCr1Zr evidence.',
        icon: 'tabler:file-certificate',
        callToAction: {
          text: 'Read CuCr1Zr guide',
          href: '/posts/EngineeringGuide/cucr1zr-copper-alloy-3d-printing-industrial-components/',
        },
      },
    ]}
  />

  <section
    class:list={['border-y border-page-border bg-surface', sectionContainerClass]}
    aria-labelledby="material-evidence-map"
  >
    <div class="mx-auto flex max-w-5xl flex-col gap-5 px-4 sm:px-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-primary">Property evidence</p>
        <h2 id="material-evidence-map" class="mt-2 font-heading text-3xl font-bold text-heading">
          Compare copper grades in their final tested state
        </h2>
        <p class="mt-3 leading-7 text-muted">
          Use the evidence map to keep alloy, heat treatment, orientation, test method, temperature and source context
          attached to conductivity, strength and thermal-property values.
        </p>
      </div>
      <a class="shrink-0 text-sm font-semibold text-link hover:underline" href="/knowledge/materials-and-properties/"
        >Open material evidence map</a
      >
    </div>
  </section>

  <CallToAction
    classes={{ container: sectionContainerClass }}
    title="Not sure which copper alloy fits the part?"
    subtitle="Send the CAD package, quantity, operating conditions, and critical requirements so we can recommend a suitable material and production route."
    actions={[
      {
        variant: 'primary',
        text: 'Email CAD and requirements',
        href: 'mailto:info@szcomo.com',
      },
    ]}
  />
</Layout>
