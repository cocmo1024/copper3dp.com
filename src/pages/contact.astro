---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import { createBreadcrumbSchema } from '~/utils/structured-data';

const metadata = {
  title: 'Copper AM RFQ Contact | Send CAD for Quote',
  description:
    'Send custom copper AM project details for CAD review: application, material target, quantity, lead time, operating constraints, and inspection requirements.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/copper/hero-1.webp',
        width: 1200,
        height: 628,
      },
    ],
    type: 'website',
  },
  structuredData: createBreadcrumbSchema([
    { name: 'Home', item: '/' },
    { name: 'Contact', item: '/contact' },
  ]),
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Project RFQ"
    title="Send CAD and engineering constraints"
    subtitle="For a useful quote, include geometry, material target, quantity, lead time, critical interfaces, and acceptance requirements."
  />

  <ContactUs
    id="form"
    title="Copper AM RFQ inputs"
    subtitle="Use the form fields as a checklist. For file transfer, email STEP, X_T, or native CAD files directly to info@szcomo.com with the same project notes."
    form={{
      name: 'copper-am-rfq',
      method: 'POST',
      action: '/rfq-submitted/',
      netlify: true,
      honeypotName: 'bot-field',
    }}
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        placeholder: 'Your name',
        autocomplete: 'name',
        required: true,
      },
      {
        type: 'email',
        name: 'email',
        label: 'Work email',
        placeholder: 'name@company.com',
        autocomplete: 'email',
        required: true,
      },
      {
        type: 'text',
        name: 'company',
        label: 'Company',
        placeholder: 'Company, lab, or project team',
        autocomplete: 'organization',
        required: true,
      },
      {
        type: 'text',
        name: 'application',
        label: 'Application',
        placeholder: 'Cold plate, heat sink, busbar, coil, RF part...',
        required: true,
      },
      {
        type: 'text',
        name: 'material',
        label: 'Target material',
        placeholder: 'Pure copper, CuCrZr, GRCop-42, or open',
      },
      {
        type: 'text',
        name: 'quantity',
        label: 'Quantity and lead time',
        placeholder: 'Prototype quantity, pilot lot, target delivery',
        required: true,
      },
    ]}
    textarea={{
      name: 'message',
      label: 'Project notes',
      rows: 6,
      required: true,
      placeholder:
        'Operating load, coolant, pressure drop, current, RF band, sealing faces, datum surfaces, leak target, CT or inspection scope, post-machining, surface finish, service environment...',
    }}
    disclaimer={{
      label:
        'I understand this first contact form is for project screening and I can send CAD files by email for quotation review.',
      required: true,
    }}
    button="Submit RFQ request"
    description="For CAD files, email STEP, X_T, or native CAD to info@szcomo.com after submitting this form."
  />

  <Features2
    title="What to include"
    items={[
      {
        title: 'CAD and drawings',
        description:
          'STEP, X_T, or native CAD files plus drawings for datum faces, sealing lands, ports, threads, contact planes, and inspection dimensions.',
      },
      {
        title: 'Operating targets',
        description:
          'Heat load, coolant, flow rate, pressure drop, current, duty cycle, RF frequency band, vacuum service, or hydrogen exposure.',
      },
      {
        title: 'Material and quantity',
        description:
          'Target material such as pure copper, CuCrZr, or GRCop-42, plus prototype quantity, pilot lot, or production intent.',
      },
      {
        title: 'Inspection evidence',
        description:
          'CT scan, leak testing, pressure testing, flow validation, dimensional reports, surface finish, cleaning, and material certification.',
      },
      {
        title: 'Email',
        description: 'info@szcomo.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Response scope',
        description: 'Feasibility notes, quote path, lead time, post-processing options, and inspection plan.',
        icon: 'tabler:clipboard-check',
      },
    ]}
  />
</Layout>
