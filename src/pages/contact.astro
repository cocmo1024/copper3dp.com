---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import { createBreadcrumbSchema } from '~/utils/structured-data';

const metadata = {
  title: 'Copper AM RFQ Contact | Send CAD for Quote',
  description:
    'Send custom copper AM project details for CAD review: application, material target, quantity, lead time, operating constraints, and inspection requirements.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/copper/hero-1.webp',
        width: 1200,
        height: 628,
      },
    ],
    type: 'website',
  },
  structuredData: createBreadcrumbSchema([
    { name: 'Home', item: '/' },
    { name: 'Contact', item: '/contact' },
  ]),
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Project RFQ"
    title="Send the details that decide feasibility and quote scope"
    subtitle="Use this form to start a copper AM review. The fastest path is CAD plus material target or operating requirements, quantity, lead time, critical interfaces, and acceptance evidence."
  />

  <ContactUs
    id="form"
    title="Start an engineering RFQ review"
    subtitle="Submit the project summary here. For file transfer, email STEP, X_T, or native CAD files directly to info@szcomo.com with the same project notes."
    form={{
      name: 'copper-am-rfq',
      method: 'POST',
      action: '/rfq-submitted/',
      netlify: true,
      honeypotName: 'bot-field',
    }}
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        placeholder: 'Your name',
        autocomplete: 'name',
        required: true,
      },
      {
        type: 'email',
        name: 'email',
        label: 'Work email',
        placeholder: 'name@company.com',
        autocomplete: 'email',
        required: true,
      },
      {
        type: 'text',
        name: 'company',
        label: 'Company',
        placeholder: 'Company, lab, or project team',
        autocomplete: 'organization',
        required: true,
      },
      {
        type: 'text',
        name: 'application',
        label: 'Application',
        placeholder: 'Cold plate, heat sink, busbar, coil, RF part...',
        required: true,
      },
      {
        type: 'text',
        name: 'material',
        label: 'Target material',
        placeholder: 'Pure copper, CuCrZr, GRCop-42, or open to recommendation',
      },
      {
        type: 'text',
        name: 'quantity',
        label: 'Quantity and lead time',
        placeholder: 'Prototype quantity, pilot lot, target delivery',
        required: true,
      },
    ]}
    textarea={{
      name: 'message',
      label: 'Project notes',
      rows: 7,
      required: true,
      placeholder:
        'Application, operating load, coolant, pressure drop, current, RF band, sealing faces, datum surfaces, leak target, CT or inspection scope, post-machining, surface finish, service environment, and anything that would make the part unacceptable...',
    }}
    disclaimer={{
      label:
        'I understand this first contact form is for project screening and I can send CAD files by email for quotation review.',
      required: true,
    }}
    button="Submit RFQ request"
    description="For CAD files, email STEP, X_T, or native CAD to info@szcomo.com after submitting this form."
  />

  <Features2
    title="What happens after you submit"
    subtitle="The goal is to turn an inquiry into a clear engineering decision path, not just a price response."
    items={[
      {
        title: 'Feasibility screen',
        description:
          'Geometry, material fit, DfAM risk, post-processing needs, and acceptance gaps are reviewed before quote assumptions are locked.',
      },
      {
        title: 'Missing inputs flagged',
        description:
          'If heat load, pressure, current, leak target, drawings, or inspection scope are missing, they can be identified early instead of delaying procurement.',
      },
      {
        title: 'Quote path aligned',
        description:
          'The response can separate feasibility notes, prototype quote scope, post-processing options, and inspection evidence needed for acceptance.',
      },
      {
        title: 'CAD transfer',
        description:
          'Send STEP, X_T, native CAD, and drawings by email when files are too large for a contact form or require project-specific handling.',
      },
      {
        title: 'Email',
        description: 'info@szcomo.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Response scope',
        description: 'Feasibility notes, quote path, lead time, post-processing options, and inspection plan.',
        icon: 'tabler:clipboard-check',
      },
    ]}
  />
</Layout>
