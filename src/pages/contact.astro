---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import SplitShowcase from '~/components/widgets/SplitShowcase.astro';
import Features2 from '~/components/widgets/Features2.astro';
import { createBreadcrumbSchema } from '~/utils/structured-data';

const sectionContainerClass = 'py-10 md:py-12 lg:py-14';
const whatsappHref =
  'https://wa.me/8615301541312?text=Hello%2C%20I%20would%20like%20to%20discuss%20a%20copper%203D%20printing%20project.';

const contactShowcases = [
  {
    imagePosition: 'left' as const,
    image: {
      src: '~/assets/images/copper/rfq-review-workspace.webp',
      alt: 'Copper AM RFQ email review workspace',
    },
    title: 'What to include',
    description:
      'A short email is fine if the project is simple. Add only the details that affect quotation and acceptance.',
    points: [
      {
        title: 'Drawings and CAD',
        description: 'Attach STEP, X_T, native CAD, or drawings with key dimensions and critical surfaces.',
      },
      {
        title: 'Quantity and timing',
        description: 'State prototype quantity, batch quantity, target delivery date, and any purchasing constraints.',
      },
      {
        title: 'Requirements',
        description:
          'Include material, pressure, leak, thermal, electrical, surface finish, machining, CT, or cleaning needs when relevant.',
      },
    ],
  },
  {
    imagePosition: 'right' as const,
    image: {
      src: '~/assets/images/copper/rfq-review-workspace.webp',
      alt: 'Copper AM quotation response workflow',
    },
    title: 'How we respond',
    description:
      'The reply depends on the drawing and the requirements. We do not force every RFQ into the same deliverable.',
    points: [
      {
        title: 'Simple quote',
        description:
          'If geometry, quantity, and basic requirements are clear, we can respond with a straightforward quotation.',
      },
      {
        title: 'Clarification questions',
        description:
          'If heat load, pressure, current, leak target, drawings, or inspection needs are unclear, we ask focused questions before quoting.',
      },
      {
        title: 'Technical discussion when needed',
        description:
          'For complex parts, we may discuss material, manufacturability, post-processing, testing, and lead-time drivers as needed.',
      },
    ],
  },
];

const metadata = {
  title: 'Copper 3D Printing RFQ | Email or WhatsApp',
  description:
    'Send a copper 3D printing RFQ by email or WhatsApp with CAD, quantity, material, lead time, operating conditions, finishing, and inspection requirements.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/copper/hero-copper-parts-transparent.webp',
        width: 1200,
        height: 675,
      },
    ],
    type: 'website',
  },
  structuredData: createBreadcrumbSchema([
    { name: 'Home', item: '/' },
    { name: 'Contact', item: '/contact/' },
  ]),
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Project RFQ"
    title="Send CAD for a copper 3D printing quotation"
    subtitle="COPPER 3DP is operated by Suzhou Como Precision Materials Co., Ltd. Send the drawing and requirements by email, or use WhatsApp for the first project discussion."
    callToAction={{
      text: 'Email CAD files',
      href: 'mailto:info@szcomo.com',
      icon: 'tabler:mail',
    }}
    callToAction2={{
      text: 'WhatsApp project review',
      href: whatsappHref,
      target: '_blank',
      rel: 'noopener noreferrer',
      icon: 'tabler:brand-whatsapp',
      'data-aw-instant-contact-link': true,
      'data-aw-contact-channel': 'whatsapp',
    }}
  />

  <Features2
    title="Choose the contact route that fits the project stage"
    subtitle="CAD and drawings should go by email. WhatsApp is useful for an initial scope check or to confirm what information is needed."
    columns={3}
    classes={{ container: sectionContainerClass }}
    items={[
      {
        title: 'Email the RFQ package',
        description:
          'Best for STEP files, drawings, quantities, material requirements, acceptance criteria, and commercial notes.',
        icon: 'tabler:mail',
        callToAction: {
          text: 'Email info@szcomo.com',
          href: 'mailto:info@szcomo.com',
        },
      },
      {
        title: 'Discuss on WhatsApp',
        description:
          'Best for the first scope check, confirming file requirements, or following up on a submitted quotation package.',
        icon: 'tabler:brand-whatsapp',
        callToAction: {
          text: '+86 153 0154 1312',
          href: whatsappHref,
          target: '_blank',
          rel: 'noopener noreferrer',
          'data-aw-instant-contact-link': true,
          'data-aw-contact-channel': 'whatsapp',
        },
      },
      {
        title: 'Review capabilities first',
        description:
          'Check the public green-laser LPBF market range, material routes, finishing, inspection, and published limitations before sending an RFQ.',
        icon: 'tabler:settings',
        callToAction: {
          text: 'Open capabilities',
          href: '/capabilities/',
        },
      },
    ]}
  />

  <CallToAction
    id="form"
    classes={{ container: sectionContainerClass }}
    title="Send the RFQ by email"
    subtitle="Email STEP, X_T, native CAD, drawings, quantity, material if known, lead time, and the requirements that matter for the part."
    actions={[
      {
        variant: 'primary',
        text: 'Email CAD files',
        href: 'mailto:info@szcomo.com',
        icon: 'tabler:mail',
      },
      {
        text: 'WhatsApp project review',
        href: whatsappHref,
        target: '_blank',
        rel: 'noopener noreferrer',
        icon: 'tabler:brand-whatsapp',
        'data-aw-instant-contact-link': true,
        'data-aw-contact-channel': 'whatsapp',
      },
    ]}
  />

  <SplitShowcase
    title="Email-first RFQ path"
    subtitle="Send the drawing and what you know. Leave unknown fields blank rather than guessing."
    items={contactShowcases}
    classes={{ container: sectionContainerClass }}
  />
</Layout>
