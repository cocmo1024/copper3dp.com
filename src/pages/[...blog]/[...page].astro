---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import EngineeringTopicClusters from '~/components/blog/EngineeringTopicClusters.astro';
// import PostTags from "~/components/blog/Tags.astro";

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { createBreadcrumbSchema, createItemListSchema } from '~/utils/structured-data';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

// const allCategories = await findCategories();
// const allTags = await findTags();

const metadata = {
  title: `Engineering Guide${currentPage > 1 ? ` | Page ${currentPage}` : ''}`,
  description:
    'Engineering articles for copper additive manufacturing: cold plates, heat sinks, CT inspection, leak testing, DfAM, material selection, and RFQ preparation.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
  structuredData: [
    createBreadcrumbSchema([
      { name: 'Home', item: '/' },
      { name: 'Engineering Guide', item: getBlogPermalink() },
    ]),
    ...(currentPage === 1
      ? [
          createItemListSchema('Primary copper AM RFQ landing pages', [
            {
              name: 'Copper 3D printing service',
              description: 'Main RFQ page for custom LPBF copper parts and application fit.',
              url: '/',
            },
            {
              name: 'Copper 3D printing applications',
              description:
                'Application map for cold plates, heat sinks, heat exchangers, busbars, RF, semiconductor, and tooling.',
              url: '/applications/',
            },
            {
              name: 'Copper AM capabilities',
              description: 'Green-laser LPBF envelope, material routes, finishing, inspection, and quotation scope.',
              url: '/capabilities/',
            },
            {
              name: '3D printed copper cold plate RFQ',
              description: 'RFQ page for cold plates, microchannels, manifolds, pressure data, and leak testing.',
              url: '/copper-cold-plates/',
            },
            {
              name: 'Custom copper heat sink RFQ',
              description: 'RFQ page for heat sinks, interface flatness, airflow, fin geometry, and validation.',
              url: '/copper-heat-sinks/',
            },
            {
              name: 'Copper AM materials',
              description: 'Material route page for pure copper, CuCrZr, CuCr1Zr, and high-temperature copper alloys.',
              url: '/materials/',
            },
            {
              name: 'Copper AM RFQ checklist',
              description: 'RFQ inputs page for drawings, quantity, material, operating limits, and inspection scope.',
              url: '/rfq/',
            },
          ]),
        ]
      : []),
    createItemListSchema(
      `Engineering Guide articles${currentPage > 1 ? ` page ${currentPage}` : ''}`,
      page.data.map((post) => ({
        name: post.title,
        description: post.excerpt,
        url: getPermalink(post.permalink, 'post'),
      }))
    ),
  ],
};
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-5xl">
    <Headline
      subtitle="Engineering notes for copper cold plates, heat sinks, inspection planning, material selection, and RFQ preparation."
    >
      Engineering Guide
    </Headline>
    {currentPage === 1 && <EngineeringTopicClusters />}
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    <!--
      <PostTags tags={allCategories} class="mb-2" title="Search by Categories:" isCategory />
      <PostTags tags={allTags}  title="Search by Tags:" />
    -->
  </section>
</Layout>
