---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Pagination from '~/components/blog/Pagination.astro';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { createBreadcrumbSchema, createItemListSchema } from '~/utils/structured-data';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const metadata = {
  title: `Engineering Library${currentPage > 1 ? ` | Page ${currentPage}` : ''}`,
  description:
    'Engineering articles for copper additive manufacturing: cold plates, heat sinks, CT inspection, leak testing, DfAM, material selection, and RFQ preparation.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
  structuredData: [
    createBreadcrumbSchema([
      { name: 'Home', item: '/' },
      { name: 'Engineering Guide', item: getBlogPermalink() },
    ]),
    ...(currentPage === 1
      ? [
          createItemListSchema('Primary copper AM RFQ landing pages', [
            {
              name: 'Copper 3D printing service',
              description: 'Main RFQ page for custom LPBF copper parts and application fit.',
              url: '/',
            },
            {
              name: 'Copper 3D printing applications',
              description:
                'Application map for cold plates, heat sinks, heat exchangers, busbars, RF, semiconductor, and tooling.',
              url: '/applications/',
            },
            {
              name: 'Copper AM capabilities',
              description: 'Green-laser LPBF envelope, material routes, finishing, inspection, and quotation scope.',
              url: '/capabilities/',
            },
            {
              name: '3D printed copper cold plate RFQ',
              description: 'RFQ page for cold plates, microchannels, manifolds, pressure data, and leak testing.',
              url: '/copper-cold-plates/',
            },
            {
              name: 'Custom copper heat sink RFQ',
              description: 'RFQ page for heat sinks, interface flatness, airflow, fin geometry, and validation.',
              url: '/copper-heat-sinks/',
            },
            {
              name: 'Copper AM materials',
              description: 'Material route page for pure copper, CuCrZr, CuCr1Zr, and high-temperature copper alloys.',
              url: '/materials/',
            },
            {
              name: 'Copper AM RFQ checklist',
              description: 'RFQ inputs page for drawings, quantity, material, operating limits, and inspection scope.',
              url: '/rfq/',
            },
          ]),
        ]
      : []),
    createItemListSchema(
      `Engineering Guide articles${currentPage > 1 ? ` page ${currentPage}` : ''}`,
      page.data.map((post) => ({
        name: post.title,
        description: post.excerpt,
        url: getPermalink(post.permalink, 'post'),
      }))
    ),
  ],
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold text-primary">Technical content</p>
      <h1 class="mt-3 font-heading text-4xl font-bold leading-tight text-heading sm:text-5xl">Engineering Library</h1>
      <p class="mt-5 text-lg leading-8 text-muted">
        Practical copper additive manufacturing articles for design, material, process, inspection, and quotation
        decisions. These pages support specific engineering questions; the main business path remains the RFQ.
      </p>
    </header>

    <nav
      class="mt-8 flex flex-wrap gap-x-6 gap-y-3 border-y border-page-border py-5 text-sm"
      aria-label="Primary project pages"
    >
      <a class="font-semibold text-link hover:underline" href="/capabilities/">Capabilities</a>
      <a class="font-semibold text-link hover:underline" href="/applications/">Applications</a>
      <a class="font-semibold text-link hover:underline" href="/materials/">Materials</a>
      <a class="font-semibold text-link hover:underline" href="/rfq/">Prepare an RFQ</a>
    </nav>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <label class="relative block w-full max-w-md" for="article-search">
        <span class="sr-only">Search engineering articles</span>
        <input
          id="article-search"
          type="search"
          placeholder="Search topics, parts, or materials"
          class="w-full rounded-md border border-page-border bg-surface px-4 py-3 text-sm text-default outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
          autocomplete="off"
        />
      </label>
      <p id="article-count" class="text-sm text-muted">{page.data.length} articles</p>
    </div>

    <div class="mt-6">
      <BlogList posts={page.data} />
    </div>
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>

  <script is:inline>
    (() => {
      const input = document.getElementById('article-search');
      const count = document.getElementById('article-count');
      const entries = Array.from(document.querySelectorAll('[data-article-entry]'));

      if (!(input instanceof HTMLInputElement) || !count) return;

      const update = () => {
        const query = input.value.trim().toLowerCase();
        let visible = 0;

        entries.forEach((entry) => {
          const match = !query || (entry.getAttribute('data-article-search') || '').includes(query);
          const listItem = entry.closest('li');
          if (listItem instanceof HTMLElement) listItem.hidden = !match;
          if (match) visible += 1;
        });

        count.textContent = `${visible} article${visible === 1 ? '' : 's'}`;
      };

      input.addEventListener('input', update);
    })();
  </script>
</Layout>
