---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import IntentLibrary from '~/components/blog/IntentLibrary.astro';
import Pagination from '~/components/blog/Pagination.astro';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { createBreadcrumbSchema, createItemListSchema } from '~/utils/structured-data';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const metadata = {
  title: `Copper 3D Printing Engineering Library${currentPage > 1 ? ` | Page ${currentPage}` : ''}`,
  description:
    'Engineering guides for copper 3D printing, thermal management, materials, inspection, design limits, and RFQ preparation for custom parts.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'website',
  },
  structuredData: [
    createBreadcrumbSchema([
      { name: 'Home', item: '/' },
      { name: 'Engineering Guide', item: getBlogPermalink() },
    ]),
    createItemListSchema(
      `Engineering Guide articles${currentPage > 1 ? ` page ${currentPage}` : ''}`,
      page.data.map((post) => ({
        name: post.title,
        description: post.excerpt,
        url: getPermalink(post.permalink, 'post'),
      }))
    ),
  ],
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold text-primary">Technical content</p>
      <h1 class="mt-3 font-heading text-4xl font-bold leading-tight text-heading sm:text-5xl">
        Copper 3D Printing Engineering Library
      </h1>
      <p class="mt-5 text-lg leading-8 text-muted">
        Browse by application or engineering decision, then open the guide closest to the part, requirement, or
        acceptance question you are working through.
      </p>
    </header>

    <nav
      class="mt-8 flex flex-wrap gap-x-6 gap-y-3 border-y border-page-border py-5 text-sm"
      aria-label="Primary project pages"
    >
      <a class="font-semibold text-link hover:underline" href="/capabilities/">Capabilities</a>
      <a class="font-semibold text-link hover:underline" href="/thermal-design-validation/">Thermal engineering</a>
      <a class="font-semibold text-link hover:underline" href="/applications/">Applications</a>
      <a class="font-semibold text-link hover:underline" href="/materials/">Materials</a>
      <a class="font-semibold text-link hover:underline" href="/rfq/">Quotation checklist</a>
    </nav>

    <IntentLibrary posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
