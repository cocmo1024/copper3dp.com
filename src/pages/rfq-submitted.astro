---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'RFQ Submitted',
  description: 'Confirmation page for submitted COPPER 3DP RFQ details and CAD file follow-up.',
  robots: {
    index: false,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="RFQ submitted"
    title="Your copper AM project details have been received"
    subtitle="The next useful step is CAD and drawing review. Send STEP, X_T, or native CAD files to info@szcomo.com with the same company and project name used in the form."
    callToAction={{
      variant: 'primary',
      text: 'Email CAD files',
      href: 'mailto:info@szcomo.com?subject=COPPER%203DP%20RFQ%20CAD%20files',
      icon: 'tabler:mail',
    }}
    callToAction2={{
      text: 'Review RFQ checklist',
      href: '/rfq',
    }}
  />

  <Features2
    title="What happens next"
    subtitle="The next response depends on the drawing package, quantity, and requirements provided."
    columns={3}
    items={[
      {
        title: 'Geometry review',
        description:
          'CAD and drawings are checked for internal channels, wall thickness, datum faces, sealing lands, ports, threads, and machining allowance.',
        icon: 'tabler:file-3d',
      },
      {
        title: 'Material and process path',
        description:
          'Pure copper, CuCrZr, GRCop-42, post-processing, and inspection options are reviewed against the operating environment.',
        icon: 'tabler:settings',
      },
      {
        title: 'Quote or clarification',
        description:
          'If the request is clear, we can quote. If key material, tolerance, testing, or post-processing details are unclear, we ask before quoting.',
        icon: 'tabler:clipboard-check',
      },
    ]}
  />

  <CallToAction
    title="Need to add drawings or requirements?"
    subtitle="Email the additional package with project name, quantity, target material if known, operating conditions, and inspection requirements when relevant."
    actions={[
      {
        variant: 'primary',
        text: 'Email engineering',
        href: 'mailto:info@szcomo.com?subject=COPPER%203DP%20RFQ%20follow-up',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
