---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features3 from '~/components/widgets/Features3.astro';
import SplitShowcase from '~/components/widgets/SplitShowcase.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import { createBreadcrumbSchema, createFaqSchema, createItemListSchema } from '~/utils/structured-data';

const rfqEmail = 'info@szcomo.com';
const rfqEmailHref = 'mailto:info@szcomo.com';
const whatsappHref =
  'https://wa.me/8615301541312?text=Hello%2C%20I%20would%20like%20to%20discuss%20a%20copper%203D%20printing%20RFQ.';
const sectionContainerClass = 'py-10 md:py-12 lg:py-14';
const rfqTemplate = `Subject: Copper 3D printing RFQ - [part name]

Hello COPPER 3DP,

Please review the attached CAD/drawings for quotation.

Part/application:
Attached files:
Quantity:
Material preference, if known:
Target lead time:
Critical dimensions or surfaces:
Operating conditions:
Inspection or test requirements:
Post-processing expected:

Notes:

Best regards,`;

const rfqFaqs = [
  {
    title: 'Will every RFQ receive the same response?',
    description:
      'No. If the drawing and quantity are clear, the reply may be a basic quote. If key requirements are missing, we ask clarification questions first.',
  },
  {
    title: 'Can I send an early concept?',
    description:
      'Yes. Early CAD is useful for a first review, but quotation usually needs material, quantity, lead time, and any critical requirements.',
  },
  {
    title: 'Do you need a drawing if CAD is available?',
    description:
      'Drawings are recommended for critical dimensions, datum faces, flatness, sealing lands, thread notes, surface finish, and inspection scope.',
  },
  {
    title: 'What if the material is not decided?',
    description:
      'Send the service temperature, conductivity target, mechanical load, and environment so pure copper, CuCrZr, or GRCop-42 can be reviewed.',
  },
  {
    title: 'How are internal channels accepted?',
    description:
      'Internal passages should define CT scope, pressure or leak targets, flow rate, pressure drop, cleaning method, and allowable blockage risk.',
  },
  {
    title: 'What affects lead time most?',
    description:
      'Geometry review, build orientation, post-machining, heat treatment, CT or leak testing, surface requirements, and material availability.',
  },
];

const rfqShowcases = [
  {
    imagePosition: 'left' as const,
    image: {
      src: '~/assets/images/copper/rfq-review-workspace.webp',
      alt: 'Copper AM RFQ review workspace',
    },
    title: 'How we handle different RFQs',
    description: 'The response depends on the part and the information provided.',
    points: [
      {
        title: 'Simple drawing quote',
        description: 'If geometry and quantity are clear, we can provide a basic quote with normal assumptions.',
      },
      {
        title: 'Clarification needed',
        description:
          'If material, tolerance, pressure, current, thermal load, or inspection needs are unclear, we ask focused questions before quoting.',
      },
      {
        title: 'Complex project review',
        description:
          'For demanding parts, we discuss process route, post-processing, inspection, and lead-time drivers as needed.',
      },
    ],
  },
  {
    imagePosition: 'right' as const,
    image: {
      src: '~/assets/images/copper/high-current-busbars.webp',
      alt: 'Copper AM RFQ review inputs',
    },
    title: 'Information that helps quotation',
    description: 'Do not overprepare if the project is simple; send what you have and note what is critical.',
    points: [
      {
        title: 'Geometry package',
        description:
          'STEP, X_T, or native CAD files plus 2D drawings for critical dimensions, datum faces, sealing lands, contact surfaces, and threaded ports.',
      },
      {
        title: 'Functional requirements',
        description:
          'Heat load, coolant, flow rate, pressure drop, current, duty cycle, frequency band, vacuum exposure, and service temperature.',
      },
      {
        title: 'Special requirements',
        description:
          'Material, quantity, lead time, CT scope, pressure or helium leak test, dimensional inspection, surface finish, and post-processing intent.',
      },
    ],
  },
];

const metadata = {
  title: 'Copper 3D Printing RFQ | Send CAD for Review',
  description:
    'Prepare a copper 3D printing RFQ with CAD, quantity, material, application, operating conditions, finishing, and inspection requirements, then open a structured email.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/copper/high-current-busbars.webp',
        width: 1200,
        height: 628,
      },
    ],
    type: 'website',
  },
  structuredData: [
    createBreadcrumbSchema([
      { name: 'Home', item: '/' },
      { name: 'RFQ Inputs', item: '/rfq/' },
    ]),
    createItemListSchema('Copper AM RFQ checklist', [
      {
        name: 'Geometry package',
        description: 'STEP, X_T, native CAD, and 2D drawings for critical faces, ports, threads, and dimensions.',
        url: '/rfq/',
      },
      {
        name: 'Functional requirements',
        description:
          'Heat load, coolant, flow rate, pressure drop, current, frequency band, vacuum, or service temperature.',
        url: '/rfq/',
      },
      {
        name: 'Special requirements',
        description:
          'CT scope, pressure or helium leak test, dimensional inspection, thermal test, and cleaning requirement.',
        url: '/rfq/',
      },
    ]),
    createFaqSchema(rfqFaqs),
  ],
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="RFQ inputs"
    title="Send enough information for a practical copper 3D printing quote"
    subtitle="A simple drawing and quantity can be enough for a first quote. For complex thermal, electrical, RF, vacuum, or fluid parts, include the requirements that affect material, finishing, and acceptance."
    callToAction={{
      text: 'Build an RFQ email',
      href: '#rfq-builder',
      icon: 'tabler:mail',
    }}
    callToAction2={{
      text: 'WhatsApp project review',
      href: whatsappHref,
      target: '_blank',
      rel: 'noopener noreferrer',
      icon: 'tabler:brand-whatsapp',
      'data-aw-instant-contact-link': true,
      'data-aw-contact-channel': 'whatsapp',
    }}
  />

  <section id="rfq-builder" class="scroll-mt-24 border-y border-page-border bg-surface py-12 md:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-primary">Structured project handoff</p>
        <h2 class="mt-2 font-heading text-3xl font-bold text-heading">Build a reviewable RFQ email</h2>
        <p class="mt-4 leading-7 text-muted">
          Complete the fields you know. The button opens a prepared email in your mail application; attach the CAD and
          controlled drawing there before sending.
        </p>
      </div>

      <form class="mt-8 grid gap-6" data-aw-rfq-builder>
        <div class="grid gap-6 md:grid-cols-2">
          <label class="grid gap-2 text-sm font-semibold text-heading">
            Your name
            <input
              class="rounded-md border border-page-border bg-page px-4 py-3 font-normal text-default outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
              name="contact_name"
              autocomplete="name"
              required
            />
          </label>
          <label class="grid gap-2 text-sm font-semibold text-heading">
            Company
            <input
              class="rounded-md border border-page-border bg-page px-4 py-3 font-normal text-default outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
              name="company"
              autocomplete="organization"
              required
            />
          </label>
          <label class="grid gap-2 text-sm font-semibold text-heading">
            Business email
            <input
              class="rounded-md border border-page-border bg-page px-4 py-3 font-normal text-default outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
              type="email"
              name="contact_email"
              autocomplete="email"
              required
            />
          </label>
          <label class="grid gap-2 text-sm font-semibold text-heading">
            Part or application
            <select
              class="rounded-md border border-page-border bg-page px-4 py-3 font-normal text-default outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
              name="application"
              required
            >
              <option value="">Select the closest fit</option>
              <option>Cold plate or heat exchanger</option>
              <option>Heat sink or heat spreader</option>
              <option>Busbar or conductive component</option>
              <option>Induction coil</option>
              <option>RF, waveguide, or vacuum part</option>
              <option>Semiconductor equipment part</option>
              <option>Tooling or conformal cooling insert</option>
              <option>Other copper component</option>
            </select>
          </label>
          <label class="grid gap-2 text-sm font-semibold text-heading">
            Material preference
            <select
              class="rounded-md border border-page-border bg-page px-4 py-3 font-normal text-default outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
              name="material"
            >
              <option>Supplier to recommend</option>
              <option>Pure copper</option>
              <option>CuCrZr</option>
              <option>CuCr1Zr</option>
              <option>GRCop or another copper alloy</option>
            </select>
          </label>
          <label class="grid gap-2 text-sm font-semibold text-heading">
            Quantity and target timing
            <input
              class="rounded-md border border-page-border bg-page px-4 py-3 font-normal text-default outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
              name="quantity_timing"
              placeholder="Example: 2 prototypes, target in 6 weeks"
              required
            />
          </label>
        </div>

        <label class="grid gap-2 text-sm font-semibold text-heading">
          Operating and acceptance requirements
          <textarea
            class="min-h-40 rounded-md border border-page-border bg-page px-4 py-3 font-normal leading-6 text-default outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
            name="requirements"
            placeholder="Heat load, current, coolant, flow, pressure, RF band, vacuum, critical surfaces, machining, CT, leak testing, conductivity, or other requirements."
            required></textarea>
        </label>

        <div
          class="flex flex-col gap-4 border-t border-page-border pt-6 sm:flex-row sm:items-center sm:justify-between"
        >
          <p class="max-w-2xl text-sm leading-6 text-muted">
            No files are uploaded to this website. Attach STEP, native CAD, and drawings in the email window that opens.
          </p>
          <button
            type="submit"
            class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md bg-primary px-5 py-3 text-sm font-semibold text-white hover:bg-primary/90"
          >
            <Icon name="tabler:mail-forward" class="h-4 w-4" />
            Open prepared email
          </button>
        </div>
      </form>
    </div>
  </section>

  <section class="relative not-prose py-10 md:py-14">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="rounded-md border border-page-border bg-surface p-6 md:p-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-primary">Email format</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-heading">Use this structure if it helps.</h2>
            <p class="mt-3 max-w-3xl text-muted">
              Send the drawing and what you know. Leave unknown fields blank rather than guessing.
            </p>
          </div>
          <a
            class="inline-flex shrink-0 items-center justify-center rounded-md border border-page-border px-4 py-2 text-sm font-semibold text-heading hover:bg-surface-raised"
            href={rfqEmailHref}
          >
            Email {rfqEmail}
          </a>
        </div>

        <pre
          id="rfq-email-template"
          class="mt-6 overflow-x-auto whitespace-pre-wrap rounded-md border border-page-border bg-[#050814] p-5 text-sm leading-6 text-[#f7f8f4]">{rfqTemplate}</pre>

        <button
          type="button"
          data-aw-copy-rfq-template
          data-aw-copy-target="rfq-email-template"
          class="mt-4 inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-secondary"
        >
          Copy RFQ email template
        </button>
      </div>
    </div>
  </section>

  <SplitShowcase
    title="RFQ review flow"
    tagline="Practical inputs"
    subtitle="Send the drawing first. Add the requirements that affect quotation and acceptance."
    items={rfqShowcases}
    classes={{ container: sectionContainerClass }}
  />

  <Features3
    title="Application RFQ paths"
    subtitle="Use the application page when the project already fits a clear copper AM part family."
    columns={3}
    classes={{ container: sectionContainerClass }}
    items={[
      {
        title: '3D printed copper cold plates',
        description:
          'Best for microchannels, manifolds, pressure data, leak targets, CT inspection, sealing lands, and liquid cooling requirements.',
        icon: 'tabler:droplet',
        callToAction: {
          text: 'Open cold plate RFQ page',
          href: '/copper-cold-plates/',
        },
      },
      {
        title: 'Custom copper heat sinks',
        description:
          'Best for fin geometry, interface flatness, contact resistance, airflow, thermal testing, and route comparison.',
        icon: 'tabler:temperature',
        callToAction: {
          text: 'Open heat sink RFQ page',
          href: '/copper-heat-sinks/',
        },
      },
      {
        title: 'Copper AM material route',
        description:
          'Best when pure copper, CuCrZr, CuCr1Zr, conductivity, strength, or heat treatment controls the quote.',
        icon: 'tabler:atom',
        callToAction: {
          text: 'Review material routes',
          href: '/materials/',
        },
      },
      {
        title: 'Capabilities and acceptance scope',
        description:
          'Use this before quoting when equipment envelope, materials, machining, CT, leak testing, or documentation controls the project.',
        icon: 'tabler:settings',
        callToAction: {
          text: 'Review capabilities',
          href: '/capabilities/',
        },
      },
    ]}
  />

  <FAQs
    title="RFQ FAQs"
    subtitle="These questions usually determine whether a copper AM quote can move quickly."
    columns={1}
    items={rfqFaqs}
  />

  <Features3
    title="Related RFQ guides"
    subtitle="Use these when the project needs more than a simple drawing-and-quantity quote."
    columns={3}
    items={[
      {
        title: 'Engineering quotation checklist',
        description:
          'A detailed checklist for CAD, drawings, material state, critical interfaces, operating requirements, post-processing, and inspection scope.',
        icon: 'tabler:file-description',
        callToAction: {
          text: 'Read quotation checklist',
          href: '/posts/EngineeringGuide/engineering-checklist-copper-3d-printed-part-quotation/',
        },
      },
      {
        title: 'Process route selection',
        description:
          'Compare LPBF copper AM, CNC, brazing, skiving, EDM, and conventional routes before locking the quote path.',
        icon: 'tabler:route',
        callToAction: {
          text: 'Read process guide',
          href: '/posts/EngineeringGuide/when-copper-3d-printing-is-better-than-cnc-machining/',
        },
      },
      {
        title: 'Busbars and coils',
        description:
          'RFQ inputs for current path, duty cycle, contact faces, cooling, insulation, plating, and inspection.',
        icon: 'tabler:bolt',
        callToAction: {
          text: 'Read electrical RFQ guide',
          href: '/posts/EngineeringGuide/3d-printed-copper-busbars-induction-coils-rfq/',
        },
      },
    ]}
  />

  <CallToAction
    title="Send the drawing and requirements"
    actions={[
      {
        variant: 'primary',
        text: 'Email CAD files',
        href: rfqEmailHref,
        icon: 'tabler:mail',
      },
      {
        text: 'WhatsApp project review',
        href: whatsappHref,
        target: '_blank',
        rel: 'noopener noreferrer',
        icon: 'tabler:brand-whatsapp',
        'data-aw-instant-contact-link': true,
        'data-aw-contact-channel': 'whatsapp',
      },
    ]}
  >
    <Fragment slot="subtitle">
      Email <a class="font-semibold underline underline-offset-4" href={rfqEmailHref}>{rfqEmail}</a> with CAD, drawings, quantity,
      material if known, lead time, service conditions, and inspection requirements when they matter.
    </Fragment>
  </CallToAction>
</Layout>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-aw-rfq-builder]');
    if (!(form instanceof HTMLFormElement)) return;

    let started = false;
    const value = (name) => {
      const field = form.elements.namedItem(name);
      return field && 'value' in field ? String(field.value).trim() : '';
    };
    const track = (name, payload = {}, options = {}) => {
      window.COPPER3DP_TRACK_EVENT?.(
        name,
        {
          page_location: window.location.href,
          page_path: window.location.pathname,
          form_name: 'copper_am_rfq_builder',
          ...payload,
        },
        options
      );
    };

    form.addEventListener('input', () => {
      if (started) return;
      started = true;
      track('rfq_form_start', { event_category: 'lead_intent' });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const application = value('application');
      const material = value('material');
      const subject = `Copper 3D printing RFQ - ${application || 'custom part'}`;
      const body = [
        'Hello COPPER 3DP,',
        '',
        'Please review this copper additive manufacturing project.',
        '',
        `Name: ${value('contact_name')}`,
        `Company: ${value('company')}`,
        `Reply email: ${value('contact_email')}`,
        `Part/application: ${application}`,
        `Material preference: ${material}`,
        `Quantity and timing: ${value('quantity_timing')}`,
        '',
        'Operating and acceptance requirements:',
        value('requirements'),
        '',
        `Source page: ${window.location.href}`,
        '',
        'I will attach the CAD and drawings to this email before sending.',
      ].join('\n');
      const href = `mailto:info@szcomo.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      let opened = false;
      const openEmail = () => {
        if (opened) return;
        opened = true;
        window.location.href = href;
      };
      const timer = window.setTimeout(openEmail, 700);

      track(
        'rfq_form_email_handoff',
        {
          application,
          material,
          method: 'structured_email_handoff',
          event_category: 'qualified_lead_intent',
        },
        {
          adsConversion: true,
          conversionKey: 'rfq_form_email_handoff',
          eventCallback: () => {
            window.clearTimeout(timer);
            openEmail();
          },
          eventTimeout: 700,
        }
      );
    });
  })();
</script>
