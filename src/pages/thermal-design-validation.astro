---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import Layout from '~/layouts/PageLayout.astro';
import thermalFlowStudyImage from '~/assets/images/partner/blt/thermal-fluid-topology-flow-study.webp';
import thermalReconstructionStudyImage from '~/assets/images/partner/blt/thermal-fluid-topology-reconstruction-study.webp';
import thermalPhysicalPrintStudyImage from '~/assets/images/partner/blt/thermal-topology-physical-print-study.webp';
import motorCoolingLayoutImage from '~/assets/images/reference/motor-cooling-four-branch-channel-layout.png';
import motorCoolingAssemblyImage from '~/assets/images/reference/motor-cooling-channel-assembly-overlay.png';
import {
  createBreadcrumbSchema,
  createCopperApplicationServiceSchema,
  createFaqSchema,
  createItemListSchema,
} from '~/utils/structured-data';

const boundaryConditions = [
  {
    title: 'Component heat sources and duty',
    description:
      'Allocate losses by component, define source footprints or volumetric heat generation, and record separate temperature limits, duty cycles, and transient events.',
    icon: 'tabler:flame',
  },
  {
    title: 'Coolant and hydraulic limits',
    description:
      'State the coolant, inlet condition, target flow, available pump head, pressure-drop budget, and working or proof pressure.',
    icon: 'tabler:droplet',
  },
  {
    title: 'Assembly heat path and interfaces',
    description:
      'Model air gaps, contact resistance, material states, thermal interfaces, keep-outs, seals, ports, mounting, and the path from each source to the coolant.',
    icon: 'tabler:box',
  },
  {
    title: 'Acceptance evidence',
    description:
      'Agree which dimensional, CT, cleanliness, flow, pressure, leak, or thermal checks will decide whether the part is accepted.',
    icon: 'tabler:clipboard-check',
  },
];

const architectureComparisons = [
  {
    architecture: 'Pin or post fields',
    studyObservation:
      'In the supplied screening work, the tested post layouts carried a lower hydraulic penalty but offered limited heat-transfer improvement.',
    designRisk:
      'Bypass flow, weak local mixing, and unresolved hotspots can remain even when total pressure loss looks acceptable.',
    decisionEvidence: 'Temperature distribution, branch flow, and pressure drop at the same operating point.',
  },
  {
    architecture: 'Continuous channels',
    studyObservation:
      'The evaluated channel concepts produced comparatively uniform cooling, but the hydraulic cost could become the dominant constraint.',
    designRisk: 'A thermally attractive route can exceed the pump-head budget or starve parallel branches.',
    decisionEvidence: 'Heat-source temperatures, flow distribution, total pressure loss, and branch-to-branch balance.',
  },
  {
    architecture: 'Thin fins and microchannels',
    studyObservation:
      'Reducing fin scale increases available area and can move active geometry closer to the heat source.',
    designRisk:
      'Print repeatability, powder removal, blockage, cleaning, wall continuity, and inspection become harder as scale falls.',
    decisionEvidence: 'Manufacturing coupons, cleaning route, internal inspection, thermal result, and pressure drop.',
  },
  {
    architecture: 'Jet impingement',
    studyObservation:
      'The supplied concept comparison found impingement useful for peak-temperature reduction and temperature uniformity.',
    designRisk:
      'Nozzle loss, return-flow congestion, erosion, clogging, and pump demand can erase the local thermal gain.',
    decisionEvidence:
      'Local heat-flux response, nozzle flow balance, return-flow field, pressure loss, and contamination plan.',
  },
  {
    architecture: 'TPMS or periodic surface cores',
    studyObservation:
      'Three surface families were screened through nine coupons, then eight product-scale core configurations were compared for formation, heat transfer, and flow resistance.',
    designRisk:
      'A family with stronger heat transfer can also carry the highest pressure penalty; rankings are geometry- and boundary-condition-specific.',
    decisionEvidence:
      'Coupon build evidence, internal inspection, paired thermal and pressure data, then product-scale confirmation.',
  },
  {
    architecture: 'Topology-led flow paths',
    studyObservation:
      'Optimization can distribute flow or material beyond straight-fin layouts, but the raw result is only a design candidate.',
    designRisk:
      'Disconnected walls, abrupt transitions, trapped powder, inaccessible features, and uninspectable passages.',
    decisionEvidence:
      'Reconstructed CAD, DfAM review, flow re-check, representative build, and agreed inspection access.',
  },
];

const designWorkflow = [
  {
    number: '01',
    title: 'Define',
    description:
      'Translate the operating problem into thermal, hydraulic, mechanical, interface, and acceptance constraints.',
  },
  {
    number: '02',
    title: 'Screen',
    description: 'Compare conventional and additive architectures before committing to a complex internal geometry.',
  },
  {
    number: '03',
    title: 'Model',
    description:
      'Evaluate candidates with traceable losses, properties, contacts, gaps, convergence checks, energy balance, and sensitivity review.',
  },
  {
    number: '04',
    title: 'Reconstruct',
    description:
      'Turn promising results into continuous walls, transitions, powder exits, machining stock, and inspectable features.',
  },
  {
    number: '05',
    title: 'Validate',
    description:
      'Build the evidence plan around dimensional, flow, pressure, leak, cleanliness, and thermal requirements.',
  },
];

const sourceStudyEvidence = [
  {
    title: 'Coupon screening before product claims',
    description:
      'Three periodic-surface families were represented by nine coupons. Formation quality, heat transfer, and flow resistance were reviewed together instead of selecting geometry from simulation alone.',
  },
  {
    title: 'Scale-up changed the engineering questions',
    description:
      'Eight product-scale cores added cell-size variation, S- and U-type flow arrangements, inlet/outlet transitions, CT review, and local manifold optimization. Coupon ranking did not replace product verification.',
  },
  {
    title: 'Thermal and hydraulic results moved independently',
    description:
      'Printed and machined cold-plate comparisons in the source material showed that a geometry change could improve heat rejection while either increasing or decreasing pressure loss. Both outcomes must be measured.',
  },
  {
    title: 'The rig matched the decision variables',
    description:
      'The referenced bench combined controlled coolant conditioning with flow, pressure, inlet/outlet temperature, and wall-temperature measurement so thermal gain could be assessed against pumping cost.',
  },
];

const modelReviewChecks = [
  {
    title: 'Loss ledger',
    description: 'Separate winding, core, magnet, semiconductor, or other source losses and their temperature limits.',
  },
  {
    title: 'Thermal path',
    description:
      'Record air gaps, interfaces, contact resistance, housings, fasteners, and the cooled surface location.',
  },
  {
    title: 'Model credibility',
    description: 'State property sources, mesh or discretization checks, convergence criteria, and energy balance.',
  },
  {
    title: 'Scenario coverage',
    description:
      'Use steady state for screening where appropriate; add transient or sensitivity cases when duty or uncertainty requires them.',
  },
];

const validationEvidence = [
  {
    question: 'Is the specified heat being removed?',
    observable: 'Coolant flow and inlet/outlet temperature difference',
    method: 'Calibrated flow and temperature measurements under an agreed heat input',
    output: 'Heat-rejection result with operating conditions and measurement boundary',
  },
  {
    question: 'Are hotspots and uniformity controlled?',
    observable: 'Wall, interface, or source-region temperature',
    method: 'Thermocouples, resistance sensors, thermal imaging, or an agreed equivalent',
    output: 'Temperature map or defined measurement-point result',
  },
  {
    question: 'Is the pumping cost acceptable?',
    observable: 'Flow rate, pressure drop, and branch balance',
    method: 'Differential pressure and flow measurement across the relevant circuit',
    output: 'Flow-pressure curve or acceptance-point result',
  },
  {
    question: 'Are hidden passages manufacturable and clean?',
    observable: 'Continuity, dimensions, residual powder, and accessible cleaning routes',
    method: 'CT, sectioning, borescope, flow comparison, or another agreed inspection',
    output: 'Internal-feature evidence tied to drawing or acceptance criteria',
  },
  {
    question: 'Is the pressure boundary acceptable?',
    observable: 'Pressure, dwell, leakage, and visible deformation',
    method: 'Project-defined proof, leak, or pressure-decay test',
    output: 'Test record with medium, limit, dwell, and acceptance rule',
  },
];

const designDeliverables = [
  'Input and assumption register, including open items and sensitivity risks',
  'Candidate architecture comparison with rejection reasons and decision criteria',
  'Simulation summary with model scope, boundary conditions, and applicability limits',
  'Manufacturable geometry or DfAM actions for walls, transitions, powder exits, machining, seals, and datums',
  'Prototype, inspection, and test plan with included evidence and acceptance points',
  'Quotation boundary defining customer-owned system validation and supplier-owned part evidence',
];

const rfqInputs = [
  'STEP or native CAD, drawings, envelope, and keep-outs',
  'Component loss table, heat-source map, duty cycle, and separate temperature limits',
  'Coolant, inlet temperature, flow target, and pressure-drop limit',
  'Air gaps, contact interfaces, material-property assumptions, and known thermal resistances',
  'Working pressure, proof pressure, and leak requirement',
  'Ports, seals, mounting, datums, and machined thermal faces',
  'Material preference, service environment, quantity, and project stage',
  'Cleaning, CT, flow, pressure, leak, and thermal acceptance scope',
];

const faqs = [
  {
    title: 'Can a thermal design review start before the CAD is finished?',
    description:
      'Yes. A useful early review can start from the heat load or heat map, temperature limit, coolant, flow or pressure-drop budget, available envelope, ports, and interfaces. The output is a scoped design route, not a guaranteed performance result.',
  },
  {
    title: 'How do you balance cooling performance and pressure drop?',
    description:
      'Candidate channels, fins, manifolds, or generated structures are compared under the same defined boundary conditions. Heat transfer, temperature uniformity, flow distribution, pressure loss, pump requirements, manufacturability, and cleaning must be reviewed together.',
  },
  {
    title: 'When is additive manufacturing the wrong thermal route?',
    description:
      'A machined, brazed, skived, extruded, tube-based, or folded-fin route is normally better when simple accessible geometry meets the thermal, pressure, quantity, inspection, and cost targets. Complexity alone is not a reason to print.',
  },
  {
    title: 'What validation can be included in a quotation?',
    description:
      'The quotation can define the applicable dimensional, CT, cleanliness, flow, pressure, leak, conductivity, surface, or thermal evidence. The exact methods and acceptance limits must be agreed for the specific part and operating conditions.',
  },
  {
    title: 'Why can an air gap or contact assumption change the predicted hotspot?',
    description:
      'A cooling channel is only one part of the assembled heat path. Air gaps, interface resistance, material properties, source allocation, and the location of the cooled surface can redistribute component temperatures even when the channel geometry and total pressure loss remain similar. These assumptions must be version-controlled and reviewed through sensitivity cases.',
  },
];

const metadata = {
  title: 'Thermal Design & Validation for Copper AM | COPPER 3DP',
  ignoreTitleTemplate: true,
  description:
    'Engineer copper cold plates and heat exchangers around heat load, coolant, pressure drop, manufacturability, inspection, and thermal validation.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/partner/blt/thermal-fluid-topology-reconstruction-study.webp',
        width: 960,
        height: 600,
        alt: 'Reconstructed thermal-fluid channel geometry from a representative engineering study',
      },
    ],
    type: 'website',
  },
  structuredData: [
    createBreadcrumbSchema([
      { name: 'Home', item: '/' },
      { name: 'Thermal design and validation', item: '/thermal-design-validation/' },
    ]),
    createCopperApplicationServiceSchema({
      id: 'thermal-design-validation',
      name: 'Copper Thermal Design and Validation Support',
      serviceType: 'Thermal-fluid design support for copper additive manufacturing',
      description:
        'Engineering support for copper cold plates, heat exchangers, heat sinks, cooling blocks, and integrated manifolds from boundary-condition review through manufacturable geometry and project-specific validation planning.',
      url: '/thermal-design-validation/',
      audienceType: 'Thermal, mechanical, electronics, R&D, product development, and purchasing teams',
    }),
    createItemListSchema('Copper thermal design and validation workflow', [
      {
        name: 'Define boundary conditions',
        description: 'Component losses, duty, coolant, hydraulic limits, assembly heat path, and acceptance evidence.',
        url: '/thermal-design-validation/#boundary-conditions',
      },
      {
        name: 'Screen cooling architectures',
        description:
          'Compare candidate structures through thermal, hydraulic, manufacturing, cleaning, and inspection evidence.',
        url: '/thermal-design-validation/#architecture-screening',
      },
      {
        name: 'Control model fidelity',
        description:
          'Track losses, contacts, air gaps, properties, convergence, energy balance, and sensitivity cases.',
        url: '/thermal-design-validation/#model-fidelity',
      },
      {
        name: 'Reconstruct manufacturable geometry',
        description:
          'Continuous passages, practical walls, powder exits, transitions, machining stock, and inspection access.',
        url: '/thermal-design-validation/#engineering-workflow',
      },
      {
        name: 'Plan project-specific validation',
        description: 'Dimensional, CT, flow, pressure, leak, cleanliness, and thermal evidence as applicable.',
        url: '/thermal-design-validation/#validation-plan',
      },
      {
        name: 'Define project deliverables',
        description:
          'Assumption register, trade study, model summary, DfAM actions, validation plan, and responsibility boundary.',
        url: '/thermal-design-validation/#design-deliverables',
      },
    ]),
    createFaqSchema(faqs),
  ],
};
---

<Layout metadata={metadata}>
  <header class="border-b border-page-border bg-page py-12 sm:py-16 lg:py-20">
    <div class="mx-auto grid max-w-5xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:gap-14">
      <div>
        <p class="text-sm font-semibold text-accent">Thermal engineering for copper AM</p>
        <h1 class="mt-3 font-heading text-4xl font-bold leading-tight tracking-[-0.03em] text-heading sm:text-5xl">
          Thermal design and validation for copper cooling hardware
        </h1>
        <p class="mt-5 text-lg leading-8 text-muted">
          Develop cold plates, heat exchangers, heat sinks, cooling blocks, and integrated manifolds around the real
          heat source, coolant, pressure-drop budget, package envelope, interfaces, and acceptance plan.
        </p>
        <p class="mt-4 leading-7 text-muted">
          Start with a design-stage thermal brief or with build-ready CAD. In both cases, the work must connect the
          assembled heat path, fluid circuit, printable geometry, and acceptance evidence.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button
            variant="primary"
            text="Start a thermal design review"
            href="/rfq/#rfq-form"
            icon="tabler:arrow-right"
          />
          <Button variant="secondary" text="See required inputs" href="#boundary-conditions" />
        </div>
        <dl class="mt-7 grid gap-4 border-t border-page-border pt-5 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-accent">Design-stage brief</dt>
            <dd class="mt-2 text-sm leading-6 text-muted">
              Heat sources, limits, coolant, envelope, interfaces, and open assumptions.
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-accent">Build-ready CAD</dt>
            <dd class="mt-2 text-sm leading-6 text-muted">
              Geometry, drawings, material, machining, inspection, and acceptance requirements.
            </dd>
          </div>
        </dl>
      </div>

      <figure>
        <div class="overflow-hidden rounded-xl border border-page-border bg-white shadow-panel">
          <Image
            src={thermalReconstructionStudyImage}
            alt="Two reconstructed topology-led cooling channel models with continuous inlet and outlet passages"
            class="aspect-[16/11] w-full object-contain p-4"
            widths={[640, 960, 1280]}
            sizes="(max-width: 1023px) calc(100vw - 2rem), 520px"
            width={960}
            height={660}
            loading="eager"
            decoding="async"
          />
        </div>
        <figcaption class="mt-3 text-xs leading-5 text-muted">
          Representative partner engineering study supplied for publication: optimization output reconstructed into
          usable channel geometry. Results remain specific to the stated boundary conditions.
        </figcaption>
      </figure>
    </div>
  </header>

  <section id="boundary-conditions" class="scroll-mt-24 border-b border-page-border bg-surface py-12 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-accent">01 | Define the problem</p>
        <h2 class="mt-2 font-heading text-3xl font-bold text-heading">
          Start with boundary conditions, not a channel pattern
        </h2>
        <p class="mt-4 leading-7 text-muted">
          A credible cooling design begins with the system constraint. Missing flow, pressure, interface, or acceptance
          data can make a visually sophisticated model impossible to quote or validate.
        </p>
      </div>

      <div class="mt-8 grid gap-px overflow-hidden rounded-md border border-page-border bg-page-border sm:grid-cols-2">
        {
          boundaryConditions.map((item) => (
            <article class="bg-page p-6 sm:p-7">
              <span class="flex h-10 w-10 items-center justify-center rounded-md border border-page-border bg-surface">
                <Icon name={item.icon} class="h-5 w-5 text-accent" />
              </span>
              <h3 class="mt-5 font-heading text-xl font-semibold text-heading">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.description}</p>
            </article>
          ))
        }
      </div>

      <div class="mt-8 grid gap-5 border-y border-page-border py-6 sm:grid-cols-[0.82fr_1.18fr] sm:gap-10">
        <h3 class="font-heading text-xl font-semibold text-heading">Every model starts with an assumption register</h3>
        <p class="text-sm leading-6 text-muted">
          Inputs are marked as confirmed, assumed, or sensitivity-controlled, with an owner for each open item. If
          component losses, contact conditions, coolant limits, or acceptance targets are unknown, the result is treated
          as architecture screening rather than a validated temperature prediction.
        </p>
      </div>
    </div>
  </section>

  <section id="architecture-screening" class="scroll-mt-24 border-b border-page-border bg-page py-12 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-accent">02 | Screen the architecture</p>
        <h2 class="mt-2 font-heading text-3xl font-bold text-heading">
          Pair every thermal gain with its hydraulic and manufacturing cost
        </h2>
        <p class="mt-4 leading-7 text-muted">
          The source material did not identify one universally best internal structure. It screened posts, channels,
          fins, impingement, periodic surfaces, and topology-led paths by comparing heat transfer, pressure loss,
          formation quality, and product-scale verification.
        </p>
      </div>

      <div class="mt-8 overflow-x-auto border-y border-page-border">
        <table class="w-full min-w-[70rem] text-left lg:min-w-0">
          <thead>
            <tr class="border-b border-page-border text-sm text-muted">
              <th class="w-[18%] px-4 py-3 font-semibold text-heading">Candidate architecture</th>
              <th class="w-[30%] px-4 py-3 font-semibold text-heading">Observation from the supplied studies</th>
              <th class="w-[27%] px-4 py-3 font-semibold text-heading">What can make it fail</th>
              <th class="px-4 py-3 font-semibold text-heading">Evidence needed for a decision</th>
            </tr>
          </thead>
          <tbody>
            {
              architectureComparisons.map((row) => (
                <tr class="border-b border-page-border last:border-0">
                  <td class="px-4 py-4 align-top font-semibold text-heading">{row.architecture}</td>
                  <td class="px-4 py-4 align-top text-sm leading-6 text-muted">{row.studyObservation}</td>
                  <td class="px-4 py-4 align-top text-sm leading-6 text-muted">{row.designRisk}</td>
                  <td class="px-4 py-4 align-top text-sm leading-6 text-muted">{row.decisionEvidence}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-4xl text-xs leading-5 text-muted">
        These are project-specific screening observations from the supplied engineering material, not universal
        rankings. Geometry, material, scale, heat flux, coolant, flow range, and acceptance limits can change the
        outcome.
      </p>
    </div>
  </section>

  <section id="model-fidelity" class="scroll-mt-24 border-b border-page-border bg-surface py-12 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
        <div>
          <p class="text-sm font-semibold text-accent">03 | Control model fidelity</p>
          <h2 class="mt-2 font-heading text-3xl font-bold text-heading">
            A small assembly assumption can move the hotspot
          </h2>
        </div>
        <div>
          <p class="leading-7 text-muted">
            A representative motor-cooling brief allocated losses to the winding, stator core, rotor core, and magnets,
            then routed one inlet into four parallel cooling branches around assembly keep-outs.
          </p>
          <p class="mt-4 leading-7 text-muted">
            When a later model version updated the assembly air-gap representation, predicted component temperatures
            shifted materially and unevenly even though the channel concept and reported hydraulic loss remained
            similar. The lesson is not a performance number: the assembled heat path can matter more than another round
            of channel-shape refinement.
          </p>
        </div>
      </div>

      <div class="mt-10 grid gap-7 lg:grid-cols-2">
        <figure class="border-t border-page-border pt-5">
          <div class="overflow-hidden rounded-lg border border-page-border bg-white">
            <Image
              src={motorCoolingLayoutImage}
              alt="One inlet divided into four parallel circular cooling branches around a central opening"
              class="aspect-[4/3] w-full object-contain p-4"
              widths={[480, 720, 960]}
              sizes="(max-width: 1023px) calc(100vw - 2rem), 480px"
              width={1040}
              height={781}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="mt-4">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent">Model input | flow circuit</p>
            <h3 class="mt-2 font-heading text-xl font-semibold text-heading">Define the branch topology</h3>
            <p class="mt-2 text-sm leading-6 text-muted">
              Record total flow, pump-head budget, branch resistance, local restrictions, and the distribution evidence
              needed before accepting a parallel circuit.
            </p>
          </figcaption>
        </figure>

        <figure class="border-t border-page-border pt-5">
          <div class="overflow-hidden rounded-lg border border-page-border bg-white">
            <Image
              src={motorCoolingAssemblyImage}
              alt="Four-branch cooling channel layout positioned inside a motor housing with assembly keep-outs"
              class="aspect-[4/3] w-full object-contain p-4"
              widths={[480, 720, 960]}
              sizes="(max-width: 1023px) calc(100vw - 2rem), 480px"
              width={1067}
              height={752}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="mt-4">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent">
              Model input | assembled heat path
            </p>
            <h3 class="mt-2 font-heading text-xl font-semibold text-heading">Place cooling inside the real assembly</h3>
            <p class="mt-2 text-sm leading-6 text-muted">
              Channel clearance, axial position, gaps, contacts, material interfaces, and source-to-coolant distance all
              belong in the model, not only in the final CAD review.
            </p>
          </figcaption>
        </figure>
      </div>

      <ol class="mt-10 grid border-y border-page-border sm:grid-cols-2 lg:grid-cols-4">
        {
          modelReviewChecks.map((item, index) => (
            <li class="border-b border-page-border px-5 py-6 sm:even:border-l lg:border-b-0 lg:border-l lg:first:border-l-0">
              <span class="font-mono text-sm font-semibold text-accent">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 font-heading text-lg font-semibold text-heading">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.description}</p>
            </li>
          ))
        }
      </ol>

      <p class="mt-5 max-w-4xl text-xs leading-5 text-muted">
        Source note: the two images above were extracted from the motor-cooling design brief supplied for this website.
        Project-specific dimensions, loads, temperatures, and operating values are intentionally omitted. The brief
        documents a steady-state model iteration, not a completed physical validation or manufacturing claim.
      </p>
    </div>
  </section>

  <section id="engineering-workflow" class="scroll-mt-24 border-b border-page-border bg-page py-12 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-accent">04 | Close the engineering loop</p>
        <h2 class="mt-2 font-heading text-3xl font-bold text-heading">
          From requirements to manufacturable, testable hardware
        </h2>
        <p class="mt-4 leading-7 text-muted">
          Simulation is one decision tool inside a larger workflow. The model, printable geometry, post-processing
          route, and validation plan must describe the same part and operating case.
        </p>
      </div>

      <ol class="mt-8 grid border-y border-page-border sm:grid-cols-2 lg:grid-cols-5">
        {
          designWorkflow.map((item) => (
            <li class="border-b border-page-border py-6 sm:px-5 sm:even:border-l lg:border-b-0 lg:border-l lg:first:border-l-0">
              <span class="font-mono text-sm font-semibold text-accent">{item.number}</span>
              <h3 class="mt-3 font-heading text-lg font-semibold text-heading">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.description}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-10 grid gap-7 lg:grid-cols-3">
        <figure class="border-t border-page-border pt-5">
          <div class="overflow-hidden rounded-lg border border-page-border bg-black">
            <Image
              src={thermalFlowStudyImage}
              alt="Thermal-fluid simulation used to screen flow coverage and local flow behavior"
              class="aspect-[16/10] w-full object-contain p-3"
              widths={[480, 720, 960]}
              sizes="(max-width: 1023px) calc(100vw - 2rem), 320px"
              width={960}
              height={600}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="mt-4">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent">Representative study | screen</p>
            <h3 class="mt-2 font-heading text-xl font-semibold text-heading">Review flow behavior</h3>
            <p class="mt-2 text-sm leading-6 text-muted">
              Compare coverage, local velocity, maldistribution, and pressure loss under the agreed coolant and boundary
              conditions.
            </p>
          </figcaption>
        </figure>

        <figure class="border-t border-page-border pt-5">
          <div class="overflow-hidden rounded-lg border border-page-border bg-white">
            <Image
              src={thermalReconstructionStudyImage}
              alt="Topology-led cooling channels reconstructed as continuous manufacturable geometry"
              class="aspect-[16/10] w-full object-contain p-3"
              widths={[480, 720, 960]}
              sizes="(max-width: 1023px) calc(100vw - 2rem), 320px"
              width={960}
              height={600}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="mt-4">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent">Representative study | rebuild</p>
            <h3 class="mt-2 font-heading text-xl font-semibold text-heading">Reconstruct the geometry</h3>
            <p class="mt-2 text-sm leading-6 text-muted">
              Add practical walls, inlet and outlet transitions, powder exits, machining stock, and inspection access.
            </p>
          </figcaption>
        </figure>

        <figure class="border-t border-page-border pt-5">
          <div class="overflow-hidden rounded-lg border border-page-border bg-surface">
            <Image
              src={thermalPhysicalPrintStudyImage}
              alt="Physical manufacturability models of two reconstructed topology-led cooling channel layouts"
              class="aspect-[16/10] w-full object-cover"
              widths={[480, 720, 960]}
              sizes="(max-width: 1023px) calc(100vw - 2rem), 320px"
              width={960}
              height={600}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="mt-4">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent">Representative study | verify</p>
            <h3 class="mt-2 font-heading text-xl font-semibold text-heading">Review build evidence</h3>
            <p class="mt-2 text-sm leading-6 text-muted">
              Use representative models or builds to challenge feature continuity, access, cleaning, edge conditions,
              and the planned inspection route.
            </p>
          </figcaption>
        </figure>
      </div>

      <p class="mt-6 max-w-4xl text-xs leading-5 text-muted">
        Source note: the three images above were extracted from BLT partner thermal-management engineering material
        supplied for publication. They illustrate the optimization-to-reconstruction workflow only; they are not
        universal performance claims or a finished-part guarantee.
      </p>
    </div>
  </section>

  <section class="border-b border-page-border bg-surface py-12 sm:py-16" aria-labelledby="source-study-evidence">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-accent">05 | Read the evidence chain</p>
        <h2 id="source-study-evidence" class="mt-2 font-heading text-3xl font-bold text-heading">
          What the supplied cold-plate studies actually demonstrate
        </h2>
        <p class="mt-4 leading-7 text-muted">
          The strongest engineering content is not a single temperature image. It is the progression from coupons to
          product-scale cores, internal inspection, paired thermal and hydraulic measurements, and a test rig built
          around the decision variables.
        </p>
      </div>

      <ol class="mt-8 grid gap-px overflow-hidden rounded-md border border-page-border bg-page-border sm:grid-cols-2">
        {
          sourceStudyEvidence.map((item, index) => (
            <li class="bg-page p-6 sm:p-7">
              <span class="font-mono text-sm font-semibold text-accent">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 font-heading text-xl font-semibold text-heading">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.description}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-8 grid gap-5 border-y border-page-border py-6 sm:grid-cols-[0.82fr_1.18fr] sm:gap-10">
        <h3 class="font-heading text-xl font-semibold text-heading">The design gate is paired evidence</h3>
        <p class="text-sm leading-6 text-muted">
          A unit cell is not approved because it has more area, and an optimization plot is not approved because it
          looks organic. The route advances only when thermal benefit, pressure loss, flow distribution, build evidence,
          cleaning, and inspection remain compatible at the relevant scale.
        </p>
      </div>
    </div>
  </section>

  <section id="validation-plan" class="scroll-mt-24 border-b border-page-border bg-page py-12 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-accent">06 | Plan validation before release</p>
        <h2 class="mt-2 font-heading text-3xl font-bold text-heading">
          Match each engineering question to an observable result
        </h2>
        <p class="mt-4 leading-7 text-muted">
          Not every project needs every test. The quotation should identify the question, observable, method, acceptance
          limit, included record, and the party responsible for final system-level thermal verification.
        </p>

        <div class="mt-8 overflow-x-auto border-y border-page-border">
          <table class="w-full min-w-[70rem] text-left lg:min-w-0">
            <thead>
              <tr class="border-b border-page-border text-sm text-muted">
                <th class="w-[24%] px-4 py-3 font-semibold text-heading">Question to answer</th>
                <th class="w-[24%] px-4 py-3 font-semibold text-heading">Observable</th>
                <th class="w-[27%] px-4 py-3 font-semibold text-heading">Possible method</th>
                <th class="px-4 py-3 font-semibold text-heading">Customer-facing evidence</th>
              </tr>
            </thead>
            <tbody>
              {
                validationEvidence.map((row) => (
                  <tr class="border-b border-page-border last:border-0">
                    <td class="px-4 py-4 align-top font-semibold text-heading">{row.question}</td>
                    <td class="px-4 py-4 align-top text-sm leading-6 text-muted">{row.observable}</td>
                    <td class="px-4 py-4 align-top text-sm leading-6 text-muted">{row.method}</td>
                    <td class="px-4 py-4 align-top text-sm leading-6 text-muted">{row.output}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="mt-4 max-w-4xl text-xs leading-5 text-muted">
          Methods are selected by project risk and scope. Listing a method here does not mean it is included in every
          quotation or that the source studies constitute certification of a new part.
        </p>
      </div>
    </div>
  </section>

  <section id="design-deliverables" class="scroll-mt-24 border-b border-page-border bg-surface py-12 sm:py-16">
    <div class="mx-auto grid max-w-5xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.82fr_1.18fr] lg:gap-14">
      <div>
        <p class="text-sm font-semibold text-accent">07 | Define the deliverable</p>
        <h2 class="mt-2 font-heading text-3xl font-bold text-heading">
          A thermal project should leave an auditable decision record
        </h2>
        <p class="mt-4 leading-7 text-muted">
          The output is more than a visually complex CAD model. Scope should state what was assumed, which candidates
          were rejected, why the selected route advanced, what evidence is included, and which system-level questions
          remain with the customer.
        </p>
      </div>

      <ul class="border-y border-page-border">
        {
          designDeliverables.map((item, index) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-3 border-b border-page-border py-4 last:border-0">
              <span class="font-mono text-sm font-semibold text-accent">{String(index + 1).padStart(2, '0')}</span>
              <span class="text-sm leading-6 text-muted">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-b border-page-border bg-page py-12 sm:py-16" aria-labelledby="thermal-rfq-inputs">
    <div class="mx-auto grid max-w-5xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.82fr_1.18fr] lg:items-start lg:gap-14">
      <div>
        <p class="text-sm font-semibold text-accent">Two project entry points</p>
        <h2 id="thermal-rfq-inputs" class="mt-2 font-heading text-3xl font-bold text-heading">
          Send a thermal brief or build-ready CAD
        </h2>
        <p class="mt-4 leading-7 text-muted">
          A design-stage brief starts with losses, temperature limits, coolant, the assembled heat path, envelope, and
          open assumptions. Build-ready CAD starts with DfAM, material, machining, inspection, and acceptance review.
          Unknown fields can remain open when they are clearly separated from confirmed requirements.
        </p>
        <Button
          variant="primary"
          text="Submit thermal requirements or CAD"
          href="/rfq/#rfq-form"
          icon="tabler:file-upload"
          class="mt-6"
        />
      </div>

      <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {
          rfqInputs.map((item) => (
            <li class="flex gap-3 border-b border-page-border pb-3 text-sm leading-6 text-muted">
              <Icon name="tabler:circle-check" class="mt-1 h-5 w-5 shrink-0 text-accent" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-b border-page-border bg-surface py-12 sm:py-16" aria-labelledby="related-thermal-pages">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-accent">Commercial paths</p>
        <h2 id="related-thermal-pages" class="mt-2 font-heading text-3xl font-bold text-heading">
          Continue with the component closest to your RFQ
        </h2>
      </div>

      <div class="mt-8 grid gap-px overflow-hidden border-y border-page-border bg-page-border md:grid-cols-3">
        <a class="group bg-page p-6" href="/copper-cold-plates/">
          <h3 class="font-heading text-lg font-semibold text-heading group-hover:text-link">Copper cold plates</h3>
          <p class="mt-2 text-sm leading-6 text-muted">
            Channel, manifold, pressure, leak, sealing, machining, CT, and acceptance requirements.
          </p>
          <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-link">
            Open cold plate RFQ path <Icon name="tabler:arrow-right" class="h-4 w-4" />
          </span>
        </a>
        <a class="group bg-page p-6" href="/copper-heat-exchangers/">
          <h3 class="font-heading text-lg font-semibold text-heading group-hover:text-link">Copper heat exchangers</h3>
          <p class="mt-2 text-sm leading-6 text-muted">
            Compact cores, internal area, pressure drop, powder removal, cleaning, flow, and leak evidence.
          </p>
          <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-link">
            Open heat exchanger RFQ path <Icon name="tabler:arrow-right" class="h-4 w-4" />
          </span>
        </a>
        <a class="group bg-page p-6" href="/copper-heat-sinks/">
          <h3 class="font-heading text-lg font-semibold text-heading group-hover:text-link">Copper heat sinks</h3>
          <p class="mt-2 text-sm leading-6 text-muted">
            Fin geometry, airflow or coolant conditions, interface flatness, mounting, and thermal validation.
          </p>
          <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-link">
            Open heat sink RFQ path <Icon name="tabler:arrow-right" class="h-4 w-4" />
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-page py-12 sm:py-16" aria-labelledby="thermal-design-faq">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-accent">FAQ</p>
        <h2 id="thermal-design-faq" class="mt-2 font-heading text-3xl font-bold text-heading">
          Thermal design and validation questions
        </h2>
      </div>

      <div class="mt-8 divide-y divide-page-border border-y border-page-border">
        {
          faqs.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-heading text-lg font-semibold text-heading">
                <span>{item.title}</span>
                <Icon name="tabler:plus" class="mt-1 h-5 w-5 shrink-0 text-accent transition group-open:rotate-45" />
              </summary>
              <p class="mt-3 max-w-4xl pr-10 leading-7 text-muted">{item.description}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
