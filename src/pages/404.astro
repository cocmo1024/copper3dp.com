---
import Layout from '~/layouts/Layout.astro';
import { getBlogPermalink, getHomePermalink, getPermalink } from '~/utils/permalinks';

const title = `Page not found`;
---

<Layout metadata={{ title, robots: { index: false, follow: true } }}>
  <main id="main-content" tabindex="-1" class="flex min-h-[70vh] items-center px-4 py-16 sm:px-6">
    <div class="mx-auto flex max-w-5xl flex-col items-center justify-center">
      <div class="max-w-xl text-center">
        <h1 class="mb-7 font-heading text-7xl font-bold leading-none sm:text-8xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h1>
        <h2 class="font-heading text-3xl font-bold text-heading">This page is no longer available</h2>
        <p class="mb-8 mt-4 text-base leading-7 text-muted sm:text-lg">
          Use the links below to continue with copper AM applications, quotation requirements, or engineering guidance.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
          <a rel="noopener noreferrer" href={getHomePermalink()} class="btn">Home</a>
          <a rel="noopener noreferrer" href={getPermalink('/applications')} class="btn">Applications</a>
          <a rel="noopener noreferrer" href={getPermalink('/rfq')} class="btn">Quotation checklist</a>
          <a rel="noopener noreferrer" href={getBlogPermalink()} class="btn">Engineering Library</a>
        </div>
      </div>
    </div>
  </main>
</Layout>
