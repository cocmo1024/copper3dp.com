---
import { SITE } from 'astrowind:config';
import businessLogo from '~/assets/brand/copper3dp-business-logo.svg';
---

<img
  src={businessLogo.src}
  width="1200"
  height="1200"
  alt="COPPER 3DP logo"
  class="h-12 w-12 flex-none rounded-full md:h-9 md:w-9 min-[800px]:h-10 min-[800px]:w-10 lg:h-12 lg:w-12"
  loading="eager"
  decoding="async"
/>
<span
  class="self-center ml-3 text-2xl font-extrabold tracking-tight text-heading whitespace-nowrap md:ml-2 md:text-lg min-[800px]:text-xl lg:ml-3 lg:text-2xl rtl:ml-0 rtl:mr-3 md:rtl:mr-2 lg:rtl:mr-3"
>
  {SITE?.name}
</span>
