---
import { Icon } from 'astro-icon/components';
---

<div class="relative notranslate" translate="no" data-aw-language-switcher>
  <button
    type="button"
    class="inline-flex items-center rounded-lg p-2.5 text-sm text-muted transition hover:bg-gray-100 hover:text-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-slate-200 dark:focus:ring-gray-700"
    aria-label="Change language"
    aria-haspopup="menu"
    aria-expanded="false"
    data-aw-language-toggle
  >
    <Icon name="tabler:language" class="h-5 w-5" />
    <span class="sr-only">Change language</span>
  </button>

  <div
    class="absolute right-0 z-50 mt-2 hidden w-44 overflow-hidden rounded-md border border-slate-200 bg-white py-1 text-sm shadow-xl shadow-slate-900/10 dark:border-slate-700 dark:bg-slate-900 dark:shadow-black/30 rtl:left-0 rtl:right-auto"
    role="menu"
    aria-label="Language options"
    data-aw-language-panel
  >
    <button
      type="button"
      class="flex w-full items-center justify-between px-4 py-2 text-left text-slate-700 transition hover:bg-slate-100 hover:text-slate-950 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white rtl:text-right"
      role="menuitem"
      data-aw-language-select
      data-lang="en"
    >
      <span>English</span>
      <span class="text-xs font-semibold text-primary dark:text-blue-300" data-aw-language-mark="en">Default</span>
    </button>
    <button
      type="button"
      class="flex w-full items-center justify-between px-4 py-2 text-left text-slate-700 transition hover:bg-slate-100 hover:text-slate-950 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white rtl:text-right"
      role="menuitem"
      data-aw-language-select
      data-lang="ar"
    >
      <span>العربية</span>
      <span class="hidden text-xs font-semibold text-primary dark:text-blue-300" data-aw-language-mark="ar">Active</span
      >
    </button>
    <button
      type="button"
      class="flex w-full items-center justify-between px-4 py-2 text-left text-slate-700 transition hover:bg-slate-100 hover:text-slate-950 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white rtl:text-right"
      role="menuitem"
      data-aw-language-select
      data-lang="fr"
    >
      <span>Français</span>
      <span class="hidden text-xs font-semibold text-primary dark:text-blue-300" data-aw-language-mark="fr">Active</span
      >
    </button>
    <button
      type="button"
      class="flex w-full items-center justify-between px-4 py-2 text-left text-slate-700 transition hover:bg-slate-100 hover:text-slate-950 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white rtl:text-right"
      role="menuitem"
      data-aw-language-select
      data-lang="de"
    >
      <span>Deutsch</span>
      <span class="hidden text-xs font-semibold text-primary dark:text-blue-300" data-aw-language-mark="de">Active</span
      >
    </button>
    <button
      type="button"
      class="flex w-full items-center justify-between px-4 py-2 text-left text-slate-700 transition hover:bg-slate-100 hover:text-slate-950 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white rtl:text-right"
      role="menuitem"
      data-aw-language-select
      data-lang="es"
    >
      <span>Español</span>
      <span class="hidden text-xs font-semibold text-primary dark:text-blue-300" data-aw-language-mark="es">Active</span
      >
    </button>
    <button
      type="button"
      class="flex w-full items-center justify-between px-4 py-2 text-left text-slate-700 transition hover:bg-slate-100 hover:text-slate-950 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white rtl:text-right"
      role="menuitem"
      data-aw-language-select
      data-lang="pt"
    >
      <span>Português</span>
      <span class="hidden text-xs font-semibold text-primary dark:text-blue-300" data-aw-language-mark="pt">Active</span
      >
    </button>
  </div>
</div>

<div id="google_translate_element" class="hidden" aria-hidden="true"></div>

<style is:global>
  .goog-te-banner-frame.skiptranslate,
  .goog-te-gadget,
  .goog-logo-link,
  #goog-gt-tt,
  iframe[id^=':'][class='skiptranslate'] {
    display: none !important;
  }

  body {
    top: 0 !important;
  }
</style>
