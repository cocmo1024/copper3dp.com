---
import { ANALYTICS } from 'astrowind:config';

const configuredAnalyticsId = ANALYTICS?.vendors?.googleAnalytics?.id
  ? String(ANALYTICS.vendors.googleAnalytics.id)
  : '';
const googleAnalyticsId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || configuredAnalyticsId;
const googleAdsConversionId = import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_ID || '';
const googleTagId = import.meta.env.PUBLIC_GOOGLE_TAG_ID || googleAnalyticsId || googleAdsConversionId;
const googleAdsRfqConversionLabel =
  import.meta.env.PUBLIC_GOOGLE_ADS_RFQ_CONVERSION_LABEL || import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_LABEL || '';
const googleAdsRfqSendTo =
  googleAdsConversionId && googleAdsRfqConversionLabel ? `${googleAdsConversionId}/${googleAdsRfqConversionLabel}` : '';
const tagIds = Array.from(new Set([googleTagId, googleAnalyticsId, googleAdsConversionId].filter(Boolean)));
const primaryTagId = tagIds[0];
const googleTagSrc = primaryTagId ? `https://www.googletagmanager.com/gtag/js?id=${primaryTagId}` : '';
---

<script is:inline define:vars={{ googleAdsRfqSendTo, googleAnalyticsId, googleAdsConversionId }}>
  window.dataLayer = window.dataLayer || [];
  window.COPPER3DP_TRACKING = {
    googleAnalyticsId,
    googleAdsConversionId,
    googleAdsRfqSendTo,
  };
</script>

{primaryTagId ? <script is:inline async src={googleTagSrc} /> : null}

<script is:inline define:vars={{ tagIds, primaryTagId }}>
  if (primaryTagId) {
    window.dataLayer = window.dataLayer || [];
    function gtag(...args) {
      dataLayer.push(args);
    }
    window.gtag = window.gtag || gtag;
    gtag('js', new Date());
    tagIds.forEach((id) => gtag('config', id));
  }
</script>
