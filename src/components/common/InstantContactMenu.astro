---
import { Icon } from 'astro-icon/components';

const phone = '8615301541312';
const greeting =
  'Hello, I would like to discuss a copper 3D printing RFQ. I can send CAD drawings, quantity, material preference, and requirements.';
const encodedGreeting = encodeURIComponent(greeting);

const whatsappHref = `https://wa.me/${phone}?text=${encodedGreeting}`;
---

<a
  class="inline-flex items-center rounded-lg p-2.5 text-sm text-muted transition hover:bg-surface-raised hover:text-[#128c7e] focus:outline-none focus:ring-4 focus:ring-page-border dark:hover:text-[#25d366]"
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Discuss an RFQ on WhatsApp"
  title="Discuss an RFQ on WhatsApp"
  data-aw-instant-contact-link
  data-aw-contact-channel="whatsapp"
>
  <Icon name="tabler:brand-whatsapp" class="h-5 w-5" />
  <span class="sr-only">Discuss an RFQ on WhatsApp</span>
</a>
