---
import { I18N, METADATA, SITE } from 'astrowind:config';
import businessLogo from '~/assets/brand/copper3dp-business-logo.png';
import type { MetaData, JsonLdNode } from '~/types';
import { getCanonical } from '~/utils/permalinks';

export interface Props {
  metadata?: MetaData;
}

const { metadata = {} } = Astro.props;

const siteUrl = String(SITE.site).replace(/\/$/, '');
const canonical = metadata.canonical || String(getCanonical(String(Astro.url.pathname)));
const pageTitle = metadata.title || METADATA?.title?.default || SITE.name;
const pageDescription = metadata.description || METADATA?.description;
const organizationId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;
const logoUrl = String(new URL(businessLogo.src, `${siteUrl}/`));

const normalizeStructuredData = (item: JsonLdNode): JsonLdNode => {
  const node = { ...item };
  delete node['@context'];
  return node;
};

const pageStructuredData = metadata.structuredData
  ? (Array.isArray(metadata.structuredData) ? metadata.structuredData : [metadata.structuredData]).map(
      normalizeStructuredData
    )
  : [];

const graph: JsonLdNode[] = [
  {
    '@type': 'Organization',
    '@id': organizationId,
    name: 'COPPER 3DP',
    alternateName: 'COPPER 3DP by Como Precision',
    legalName: 'Suzhou Como Precision Materials Co., Ltd.',
    url: `${siteUrl}/`,
    email: 'info@szcomo.com',
    telephone: '+86 153 0154 1312',
    sameAs: ['https://www.szcomo.com/'],
    logo: {
      '@type': 'ImageObject',
      url: logoUrl,
      width: 1200,
      height: 1200,
    },
    description: METADATA?.description,
    knowsAbout: [
      'LPBF copper additive manufacturing',
      'Copper 3D printing',
      'Copper cold plates',
      'Copper heat sinks',
      'CuCrZr',
      'Pure copper',
      'GRCop-42',
      'DfAM review',
      'Post-processing and inspection planning',
    ],
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: 'info@szcomo.com',
        telephone: '+86 153 0154 1312',
        url: 'https://wa.me/8615301541312',
        areaServed: 'Worldwide',
        availableLanguage: ['en', 'zh'],
      },
    ],
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${siteUrl}/`,
    name: SITE.name,
    description: METADATA?.description,
    publisher: { '@id': organizationId },
    inLanguage: I18N?.language || 'en',
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: pageTitle,
    ...(pageDescription ? { description: pageDescription } : {}),
    isPartOf: { '@id': websiteId },
    about: { '@id': organizationId },
    inLanguage: I18N?.language || 'en',
  },
  ...pageStructuredData,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
