---
import { Icon } from 'astro-icon/components';

type ContentItem = {
  title: string;
  description: string;
};

type Requirement = {
  input: string;
  why: string;
};

type LinkItem = {
  href: string;
  title: string;
  description: string;
};

export interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  verdict: string;
  useCases: ContentItem[];
  additiveFit: string[];
  conventionalFit: string[];
  requirements: Requirement[];
  risks: ContentItem[];
  rfqChecklist: string[];
  related: LinkItem[];
  references?: LinkItem[];
  emailSubject: string;
}

const {
  eyebrow,
  title,
  intro,
  verdict,
  useCases,
  additiveFit,
  conventionalFit,
  requirements,
  risks,
  rfqChecklist,
  related,
  references = [],
  emailSubject,
} = Astro.props;

const rfqHref = `/rfq/?project=${encodeURIComponent(emailSubject)}#rfq-form`;
---

<article>
  <header class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-primary">{eyebrow}</p>
      <h1 class="mt-3 font-heading text-4xl font-bold leading-tight text-heading sm:text-5xl">{title}</h1>
      <p class="mt-5 text-lg leading-8 text-muted sm:text-xl">{intro}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-3 text-sm font-semibold text-white hover:bg-primary/90"
          href={rfqHref}
        >
          <Icon name="tabler:file-upload" class="h-4 w-4" />
          Start secure RFQ
        </a>
        <a
          class="inline-flex items-center gap-2 rounded-md border border-page-border px-5 py-3 text-sm font-semibold text-heading hover:bg-surface-raised"
          href="/rfq/"
        >
          Review RFQ inputs
          <Icon name="tabler:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="mt-10 border-y border-page-border py-6">
      <p class="text-sm font-semibold uppercase text-primary">Short answer</p>
      <p class="mt-2 max-w-4xl text-lg leading-8 text-default">{verdict}</p>
    </div>
  </header>

  <section class="border-y border-page-border bg-surface py-12 sm:py-14" aria-labelledby="application-use-cases">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-primary">Application intent</p>
        <h2 id="application-use-cases" class="mt-2 font-heading text-3xl font-bold text-heading">
          Parts and problems this page covers
        </h2>
      </div>
      <div class="mt-8 grid border-t border-page-border md:grid-cols-2">
        {
          useCases.map((item) => (
            <div class="border-b border-page-border py-6 md:odd:pr-8 md:even:border-l md:even:pl-8">
              <h3 class="font-heading text-xl font-semibold text-heading">{item.title}</h3>
              <p class="mt-2 leading-7 text-muted">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-14" aria-labelledby="route-decision">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-primary">Manufacturing route</p>
        <h2 id="route-decision" class="mt-2 font-heading text-3xl font-bold text-heading">
          Print only when geometry creates measurable value
        </h2>
      </div>
      <div class="mt-8 grid gap-10 md:grid-cols-2">
        <div>
          <h3 class="font-heading text-xl font-semibold text-heading">Copper AM is worth reviewing when</h3>
          <ul class="mt-4 space-y-3 text-muted">
            {
              additiveFit.map((item) => (
                <li class="flex gap-3">
                  <>
                    <Icon name="tabler:check" class="mt-1 h-5 w-5 shrink-0 text-primary" />
                    <span>{item}</span>
                  </>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="font-heading text-xl font-semibold text-heading">Keep a conventional route when</h3>
          <ul class="mt-4 space-y-3 text-muted">
            {
              conventionalFit.map((item) => (
                <li class="flex gap-3">
                  <>
                    <Icon name="tabler:minus" class="mt-1 h-5 w-5 shrink-0 text-muted" />
                    <span>{item}</span>
                  </>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-page-border bg-surface py-12 sm:py-14" aria-labelledby="requirements-table">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-primary">Engineering inputs</p>
        <h2 id="requirements-table" class="mt-2 font-heading text-3xl font-bold text-heading">
          Requirements that change feasibility and price
        </h2>
      </div>
      <div class="mt-8 overflow-x-auto border-y border-page-border">
        <table class="w-full min-w-[42rem] text-left">
          <thead>
            <tr class="border-b border-page-border text-sm text-muted">
              <th class="w-1/3 px-4 py-3 font-semibold text-heading">RFQ input</th>
              <th class="px-4 py-3 font-semibold text-heading">Why it matters</th>
            </tr>
          </thead>
          <tbody>
            {
              requirements.map((row) => (
                <tr class="border-b border-page-border last:border-0">
                  <>
                    <td class="px-4 py-4 font-semibold text-heading">{row.input}</td>
                    <td class="px-4 py-4 leading-7 text-muted">{row.why}</td>
                  </>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-14" aria-labelledby="application-risks">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-primary">Risk control</p>
        <h2 id="application-risks" class="mt-2 font-heading text-3xl font-bold text-heading">
          Failure modes to resolve before quotation
        </h2>
      </div>
      <div class="mt-8 grid gap-x-10 gap-y-7 md:grid-cols-2">
        {
          risks.map((item) => (
            <div>
              <>
                <h3 class="font-heading text-lg font-semibold text-heading">{item.title}</h3>
                <p class="mt-2 leading-7 text-muted">{item.description}</p>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-page-border bg-surface py-12 sm:py-14" aria-labelledby="application-rfq">
    <div class="mx-auto grid max-w-5xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="text-sm font-semibold text-primary">Quotation</p>
        <h2 id="application-rfq" class="mt-2 font-heading text-3xl font-bold text-heading">Send a reviewable RFQ</h2>
        <p class="mt-4 leading-7 text-muted">
          A STEP file starts the geometry review. The operating and acceptance requirements prevent the quote from being
          based on assumptions that later become rework.
        </p>
      </div>
      <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {
          rfqChecklist.map((item) => (
            <li class="flex gap-3 border-b border-page-border pb-3 text-muted">
              <>
                <Icon name="tabler:circle-check" class="mt-1 h-5 w-5 shrink-0 text-primary" />
                <span>{item}</span>
              </>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-12 sm:py-14" aria-labelledby="related-engineering">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <h2 id="related-engineering" class="font-heading text-2xl font-bold text-heading">Related engineering pages</h2>
      <ul class="mt-5 border-t border-page-border">
        {
          related.map((link) => (
            <li class="border-b border-page-border">
              <a class="group flex items-start justify-between gap-6 py-4" href={link.href}>
                <>
                  <span>
                    <>
                      <span class="font-semibold text-heading group-hover:text-link">{link.title}</span>
                      <span class="mt-1 block text-sm leading-6 text-muted">{link.description}</span>
                    </>
                  </span>
                  <Icon name="tabler:arrow-right" class="mt-1 h-4 w-4 shrink-0 text-muted group-hover:text-link" />
                </>
              </a>
            </li>
          ))
        }
      </ul>

      {
        references.length > 0 && (
          <div class="mt-10">
            <>
              <h2 class="font-heading text-xl font-bold text-heading">Technical references</h2>
              <p class="mt-2 text-sm leading-6 text-muted">
                External references are provided for process and application context. Project acceptance values must
                still be defined from the drawing and operating requirement.
              </p>
              <ul class="mt-4 space-y-2 text-sm">
                {references.map((link) => (
                  <li>
                    <a
                      class="font-semibold text-link hover:underline"
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.title}
                    </a>
                    <span class="text-muted"> - {link.description}</span>
                  </li>
                ))}
              </ul>
            </>
          </div>
        )
      }
    </div>
  </section>

  <section class="border-t border-page-border py-12 sm:py-14">
    <div class="mx-auto flex max-w-5xl flex-col gap-5 px-4 sm:px-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold text-primary">Start with the part</p>
        <h2 class="mt-2 font-heading text-3xl font-bold text-heading">
          Send the drawing and the requirements that matter.
        </h2>
      </div>
      <a
        class="inline-flex shrink-0 items-center gap-2 rounded-md bg-primary px-5 py-3 text-sm font-semibold text-white hover:bg-primary/90"
        href={rfqHref}><Icon name="tabler:file-upload" class="h-4 w-4" />Submit project for review</a
      >
    </div>
  </section>
</article>
