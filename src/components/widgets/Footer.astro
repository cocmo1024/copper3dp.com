---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  partnerLinks?: Links;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], partnerLinks, footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-page-border not-prose']} data-nosnippet>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div
    class="relative mx-auto max-w-5xl px-4 py-10 text-page sm:px-6 lg:py-12 intersect-once intersect-quarter intersect-no-queue"
  >
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,2fr)] lg:gap-14">
      <div class="max-w-sm">
        <a class="inline-block text-lg font-bold text-heading" href={getHomePermalink()}>{SITE?.name}</a>
        <p class="mt-4 text-sm leading-6 text-muted">
          Copper 3D printing services for functional parts, from DfAM review and green-laser LPBF to finishing,
          inspection, and delivery. Send CAD, quantity, and critical requirements for a quotation.
        </p>
        {
          partnerLinks?.links?.length ? (
            <div class="mt-6">
              <div class="mb-3 text-sm font-semibold text-heading">{partnerLinks.title}</div>
              <ul class="space-y-2.5 text-sm leading-6">
                {partnerLinks.links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="text-muted transition duration-150 ease-in-out hover:text-link hover:underline"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            ''
          )
        }
      </div>
      <nav class="grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-3 lg:gap-x-10" aria-label="Footer navigation">
        {
          links.map(({ title, links }) => (
            <div>
              <div class="mb-3 text-sm font-semibold text-heading">{title}</div>
              {links && Array.isArray(links) && links.length > 0 && (
                <ul class="space-y-2.5 text-sm leading-6">
                  {links.map(({ text, href, ariaLabel }) => (
                    <li>
                      <a
                        class="text-muted transition duration-150 ease-in-out hover:text-link hover:underline"
                        href={href}
                        aria-label={ariaLabel}
                      >
                        <Fragment set:html={text} />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </nav>
    </div>
    <div
      class="mt-10 flex flex-col gap-4 border-t border-page-border pt-6 text-xs sm:flex-row sm:items-center sm:justify-between sm:text-sm"
    >
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-muted">
        <span><Fragment set:html={footNote} /></span>
        {
          secondaryLinks.map(({ text, href }, index) => (
            <>
              {index !== 0 ? <span class="text-page-border">/</span> : ''}
              <a
                class="text-muted transition duration-150 ease-in-out hover:text-link hover:underline"
                href={href}
                set:html={text}
              />
            </>
          ))
        }
      </div>

      {
        socialLinks?.length ? (
          <ul class="-ml-2 flex items-center gap-1 sm:ml-4 rtl:ml-0 rtl:-mr-2 rtl:sm:ml-0 rtl:sm:mr-4">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="inline-flex items-center rounded-md p-2 text-muted transition hover:bg-surface-raised hover:text-link focus:outline-none focus:ring-2 focus:ring-focus"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="h-5 w-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }
    </div>
  </div>
</footer>
