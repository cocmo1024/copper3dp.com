---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import InstantContactMenu from '~/components/common/InstantContactMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showInstantContactMenu?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showInstantContactMenu = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const mainNavigationId = 'main-navigation';
const isCurrentPath = (href?: string) => Boolean(href && `/${trimSlash(href)}` === currentPath);
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-transparent transition-[opacity] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative mx-auto w-full px-4 py-3.5 text-default sm:px-6',
      {
        'md:flex md:justify-between': position !== 'center',
      },
      {
        'md:grid md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] md:items-center': position === 'center',
      },
      {
        'max-w-5xl': !isFullWidth,
      },
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>
      <div class="flex items-center md:hidden">
        <ToggleMenu controls={mainNavigationId} />
      </div>
    </div>
    <nav
      id={mainNavigationId}
      class="items-center w-full md:w-auto hidden md:flex md:mx-3 text-default overflow-y-auto overflow-x-hidden md:overflow-y-visible md:overflow-x-auto md:justify-self-center"
      aria-label="Main navigation"
    >
      <ul
        class="flex w-full flex-col text-xl font-medium md:w-auto md:flex-row md:self-center md:justify-center md:text-sm"
      >
        {
          links.map(({ text, href, links }, index) => (
            <li class={links?.length ? 'dropdown' : ''}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    aria-haspopup="true"
                    aria-controls={`main-navigation-submenu-${index}`}
                    aria-expanded="false"
                    class="hover:text-link dark:hover:text-accent px-3 py-3 flex items-center whitespace-nowrap"
                  >
                    {text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                  </button>
                  <ul
                    id={`main-navigation-submenu-${index}`}
                    class="dropdown-menu rounded-md border border-page-border bg-surface pl-4 font-medium shadow-panel md:absolute md:hidden md:min-w-[210px] md:pl-0"
                  >
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'first:rounded-t last:rounded-b md:hover:bg-surface-raised hover:text-link dark:hover:text-accent py-2 px-5 block whitespace-no-wrap',
                            { 'aw-link-active': isCurrentPath(href2) },
                          ]}
                          href={href2}
                          aria-current={isCurrentPath(href2) ? 'page' : undefined}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-link dark:hover:text-accent px-3 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': isCurrentPath(href) },
                  ]}
                  href={href}
                  aria-current={isCurrentPath(href) ? 'page' : undefined}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <noscript>
      <style is:inline>
        [data-aw-toggle-menu] {
          display: none !important;
        }
      </style>
      <nav class="mt-4 border-t border-page-border pt-3 md:hidden" aria-label="Main navigation without JavaScript">
        <ul class="space-y-2 text-base font-medium">
          {
            links.map(({ text, href, links }) => (
              <li>
                {href ? (
                  <a class="block py-2 text-link" href={href} aria-current={isCurrentPath(href) ? 'page' : undefined}>
                    {text}
                  </a>
                ) : (
                  <span class="block py-2 text-heading">{text}</span>
                )}
                {links?.length ? (
                  <ul class="ml-4 space-y-1 border-l border-page-border pl-4">
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class="block py-1.5 text-link"
                          href={href2}
                          aria-current={isCurrentPath(href2) ? 'page' : undefined}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </li>
            ))
          }
        </ul>
      </nav>
    </noscript>
    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden md:self-center md:flex items-center md:mb-0 fixed w-full md:w-auto md:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 md:p-0 md:justify-self-end',
      ]}
    >
      <div class="items-center flex justify-between w-full md:w-auto">
        <div class="flex">
          {showInstantContactMenu && <InstantContactMenu />}
        </div>
        {
          actions?.length ? (
            <span class="ml-3 rtl:ml-0 rtl:mr-3">
              {actions.map((btnProps) => (
                <Button
                  {...btnProps}
                  class="ml-2 whitespace-nowrap py-2.5 px-4 font-semibold shadow-none text-sm w-auto"
                />
              ))}
            </span>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>
</header>
