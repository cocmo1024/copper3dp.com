---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(35 93 215);
    --aw-color-secondary: rgb(29 73 167);
    --aw-color-accent: rgb(166 83 43);
    --aw-color-link: rgb(35 93 215);

    --aw-color-text-heading: rgb(20 23 29);
    --aw-color-text-default: rgb(48 55 68);
    --aw-color-text-page: var(--aw-color-text-default);
    --aw-color-text-muted: rgb(102 112 133);
    --aw-color-bg-page: rgb(245 246 248);
    --aw-color-bg-page-dark: rgb(7 10 16);
    --aw-color-surface: rgb(255 255 255);
    --aw-color-surface-raised: rgb(240 242 245);
    --aw-color-border: rgb(213 217 225);

    ::selection {
      background-color: rgb(246 228 217);
      color: rgb(111 50 25);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(55 112 255);
    --aw-color-secondary: rgb(39 88 220);
    --aw-color-accent: rgb(229 154 101);
    --aw-color-link: rgb(103 163 255);

    --aw-color-text-heading: rgb(246 247 244);
    --aw-color-text-default: rgb(213 218 226);
    --aw-color-text-page: var(--aw-color-text-default);
    --aw-color-text-muted: rgb(148 156 170);
    --aw-color-bg-page: rgb(7 10 16);
    --aw-color-bg-page-dark: rgb(7 10 16);
    --aw-color-surface: rgb(15 19 27);
    --aw-color-surface-raised: rgb(21 26 36);
    --aw-color-border: rgb(47 55 68);

    ::selection {
      background-color: rgb(118 57 29);
      color: rgb(255 241 232);
    }
  }
</style>
