---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(37 99 235);
    --aw-color-secondary: rgb(29 78 216);
    --aw-color-accent: rgb(138 63 30);
    --aw-color-link: rgb(37 99 235);

    --aw-color-text-heading: rgb(17 24 39);
    --aw-color-text-default: rgb(36 48 68);
    --aw-color-text-page: var(--aw-color-text-default);
    --aw-color-text-muted: rgb(94 107 126);
    --aw-color-bg-page: rgb(247 248 250);
    --aw-color-bg-page-dark: rgb(5 8 20);
    --aw-color-surface: rgb(255 255 255);
    --aw-color-surface-raised: rgb(249 250 252);
    --aw-color-border: rgb(216 222 232);

    ::selection {
      background-color: rgb(255 243 234);
      color: rgb(122 53 28);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(37 99 235);
    --aw-color-secondary: rgb(29 78 216);
    --aw-color-accent: rgb(242 166 109);
    --aw-color-link: rgb(96 165 250);

    --aw-color-text-heading: rgb(247 248 244);
    --aw-color-text-default: rgb(220 229 242);
    --aw-color-text-page: var(--aw-color-text-default);
    --aw-color-text-muted: rgb(156 170 189);
    --aw-color-bg-page: rgb(5 8 20);
    --aw-color-bg-page-dark: rgb(5 8 20);
    --aw-color-surface: rgb(17 24 39);
    --aw-color-surface-raised: rgb(23 32 51);
    --aw-color-border: rgb(42 52 72);

    ::selection {
      background-color: rgb(122 53 28);
      color: rgb(255 243 234);
    }
  }
</style>
