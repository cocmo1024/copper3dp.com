---
import { Icon } from 'astro-icon/components';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
const searchText = [post.title, post.excerpt, ...(post.tags?.map((tag) => tag.title) || [])]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  class="group grid gap-4 border-b border-page-border py-6 sm:grid-cols-[8rem_minmax(0,1fr)_auto] sm:items-start sm:gap-7"
  data-article-entry
  data-article-search={searchText}
>
  <div class="text-sm leading-6 text-muted">
    <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
    {post.readingTime && <span class="block">{post.readingTime} min read</span>}
  </div>

  <div class="min-w-0">
    <h2 class="font-heading text-xl font-semibold leading-snug text-heading sm:text-2xl">
      {
        link ? (
          <a class="hover:text-link" href={link}>
            {post.title}
          </a>
        ) : (
          post.title
        )
      }
    </h2>
    {post.excerpt && <p class="mt-2 max-w-3xl text-sm leading-6 text-muted sm:text-base">{post.excerpt}</p>}
  </div>

  {
    link && (
      <a
        href={link}
        class="hidden rounded-md p-2 text-muted hover:bg-surface-raised hover:text-link sm:inline-flex"
        aria-label={`Read ${post.title}`}
      >
        <Icon name="tabler:arrow-right" class="h-5 w-5" />
      </a>
    )
  }
</article>
