---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import capabilityImage from '~/assets/images/generated/copper-production-components-screening.webp';
import { getArticleRfqContext } from '~/utils/rfq-context';
import type { Post } from '~/types';

interface Props {
  post: Post;
}
const context = getArticleRfqContext(Astro.props.post);
---

<section
  class="mx-auto mt-12 max-w-4xl px-4 sm:px-6"
  aria-label="Copper additive manufacturing production inquiry"
  data-nosnippet
>
  <div
    class="overflow-hidden rounded-md border border-page-border bg-surface shadow-panel md:grid md:grid-cols-[minmax(0,1fr)_18rem]"
  >
    <div class="px-5 py-7 sm:px-7 sm:py-8">
      <p class="text-sm font-semibold text-primary">Copper AM quotation</p>
      <h2 class="mt-2 font-heading text-2xl font-bold leading-tight text-heading">{context.heading}</h2>
      <p class="mt-3 max-w-xl text-sm leading-6 text-muted sm:text-base">
        {context.brief}
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a
          href={context.href}
          data-aw-cta-location="article_footer"
          class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary/90"
        >
          <Icon name="tabler:file-upload" class="h-4 w-4" />
          Start an online inquiry
        </a>
        <a class="text-sm font-semibold text-link hover:underline" href="mailto:info@szcomo.com">Prefer email?</a>
      </div>
      <p class="mt-4 text-sm leading-6 text-muted">
        Before you submit: <a class="font-semibold text-link hover:underline" href={context.service.href}
          >{context.service.title}</a
        >.
      </p>
    </div>

    <Image
      src={capabilityImage}
      alt="Copper additive manufacturing parts for production review"
      class="h-48 w-full border-t border-page-border object-cover md:h-full md:border-l md:border-t-0"
      widths={[480, 720]}
      sizes="(max-width: 767px) calc(100vw - 2rem), 288px"
      width={720}
      height={540}
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
