---
import Image from '~/components/common/Image.astro';
import equipmentImage from '~/assets/images/generated/copper-am-equipment-cuforge-gl-350-banner.webp';

const equipmentSpecs = ['532 nm green laser', '250 x 250 x 350 mm class', 'Pure Cu / CuCrZr / copper alloys'];
---

<section
  class="mx-auto mt-10 max-w-3xl px-6 sm:px-6"
  aria-label="Copper additive manufacturing equipment inquiry"
  data-nosnippet
>
  <div class="relative min-h-[420px] overflow-hidden rounded-md border border-page-border bg-[#050814] text-white">
    <Image
      src={equipmentImage}
      alt="CuForge GL-350 green laser copper additive manufacturing equipment"
      class="absolute inset-0 h-full w-full object-cover"
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 768px) calc(100vw - 3rem), 720px"
      width={1600}
      height={900}
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#050814] via-[#050814]/88 to-[#050814]/18"></div>

    <div class="relative flex min-h-[420px] max-w-xl flex-col justify-center px-5 py-7 sm:px-8">
      <p
        class="mb-3 inline-flex w-fit items-center gap-2 rounded border border-emerald-300/35 bg-emerald-300/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-emerald-100"
      >
        <span class="h-2 w-2 rounded-full bg-emerald-300" aria-hidden="true"></span>
        Green-Laser Copper AM
      </p>

      <h2 class="font-heading text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl">
        Interested in Copper AM Equipment?
      </h2>

      <p class="mt-3 max-w-md text-sm leading-6 text-slate-200 sm:text-base">
        For teams evaluating green-laser LPBF equipment for pure copper, CuCrZr, and copper alloy components, send the
        target material, build size, sample geometry, and application requirements for review.
      </p>

      <ul class="mt-5 grid max-w-md gap-2 text-sm text-slate-100 sm:grid-cols-3">
        {
          equipmentSpecs.map((spec) => (
            <li class="rounded border border-white/14 bg-white/8 px-3 py-2 leading-snug backdrop-blur-sm">{spec}</li>
          ))
        }
      </ul>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="mailto:info@szcomo.com"
          class="inline-flex items-center justify-center gap-2 rounded bg-white px-4 py-2.5 text-sm font-semibold text-[#050814] transition hover:bg-emerald-100"
          aria-label="Ask about copper additive manufacturing equipment by email"
        >
          Ask About Equipment
        </a>
        <span class="text-xs leading-5 text-slate-300"
          >Include material, quantity, build envelope, and process goals.</span
        >
      </div>
    </div>
  </div>
</section>
