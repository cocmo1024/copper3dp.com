---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import CopperAmEquipmentCta from '~/components/blog/CopperAmEquipmentCta.astro';
import KnowledgePathways from '~/components/blog/KnowledgePathways.astro';
import { getBlogPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post } = Astro.props;
const articleContainerClass = 'mx-auto max-w-4xl px-4 sm:px-6';
---

<article class="py-10 sm:py-14 lg:py-16">
  <header class={articleContainerClass}>
    <a class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-link" href={getBlogPermalink()}>
      <Icon name="tabler:arrow-left" class="h-4 w-4" />
      Engineering Library
    </a>

    <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
      <time datetime={(post.updateDate || post.publishDate).toISOString()}>
        {post.updateDate ? 'Updated ' : ''}{getFormattedDate(post.updateDate || post.publishDate)}
      </time>
      {post.readingTime && <span aria-hidden="true">·</span>}
      {post.readingTime && <span>{post.readingTime} min read</span>}
      {post.author && <span aria-hidden="true">·</span>}
      {
        post.author && (
          <a class="hover:text-link hover:underline" href="/editorial-policy/">
            {post.author.replaceAll('-', ' ')}
          </a>
        )
      }
    </div>

    <h1 class="mt-4 font-heading text-3xl font-bold leading-tight text-heading sm:text-4xl lg:text-5xl">
      {post.title}
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-muted sm:text-xl">{post.excerpt}</p>

    {
      post.image ? (
        <Image
          src={post.image}
          class="mt-8 aspect-[16/9] w-full rounded-md border border-page-border bg-surface-raised object-cover"
          widths={[480, 720, 960, 1200]}
          sizes="(max-width: 768px) calc(100vw - 2rem), 848px"
          alt={post.title}
          width={1200}
          height={675}
          loading="eager"
          decoding="async"
        />
      ) : (
        <div class="mt-8 border-t border-page-border" />
      )
    }
  </header>

  <div
    class:list={[
      articleContainerClass,
      'prose mt-10 max-w-4xl prose-base dark:prose-invert sm:prose-lg dark:prose-headings:text-heading prose-headings:font-heading prose-headings:font-bold prose-headings:leading-tight prose-a:text-link prose-img:w-full prose-img:rounded-md prose-img:border prose-img:border-page-border prose-img:shadow-none prose-headings:scroll-mt-[80px] prose-li:my-0',
    ]}
  >
    <slot />
  </div>

  <KnowledgePathways post={post} />
  <CopperAmEquipmentCta />
</article>
