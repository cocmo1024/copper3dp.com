import type { Post } from '~/types';

export interface Props {
  post: Post;
}

type LinkItem = {
  href: string;
  title: string;
  description: string;
};

type LinkGroup = {
  title: string;
  matches: string[];
  links: LinkItem[];
};

const { post } = Astro.props;

const normalizePath = (href: string) => {
  const path = href.split('#')[0].split('?')[0];
  if (path === '/') return path;
  return path.endsWith('/') ? path : `${path}/`;
};

const postPath = normalizePath(`/${post.permalink}/`);
const tagTokens = (post.tags || []).flatMap((tag) => [tag.slug, tag.title]);
const haystack = [post.slug, post.title, post.excerpt, post.category?.slug, post.category?.title, ...tagTokens]
  .filter(Boolean)
  .join(' ')
