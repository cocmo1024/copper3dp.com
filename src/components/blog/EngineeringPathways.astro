      description: 'Convert heat load, airflow, interface, and validation needs into quotable inputs.',
    },
    {
      href: '/posts/EngineeringGuide/wear-accuracy-failures-3d-printed-copper-edm-electrodes/',
      title: '3D printed copper EDM electrode failures',
      description: 'Review wear, accuracy, surface condition, and acceptance risks for copper electrode projects.',
    }
  );
}

const isSelf = (link: LinkItem) => normalizePath(link.href) === postPath;
const interleaveLinks = (groups: LinkGroup[], maxRounds = 4) => {
  const links: LinkItem[] = [];

  for (let index = 0; index < maxRounds; index += 1) {
    let found = false;

    groups.forEach((group) => {
      const link = group.links[index];
      if (link) {
        links.push(link);
        found = true;
      }
    });

    if (!found) break;
  }

  return links;
};
const uniqueLinks = (links: LinkItem[]) => {
  const seen = new Set<string>();
  return links.filter((link) => {
    const key = normalizePath(link.href);
    if (seen.has(key) || isSelf(link)) return false;
    seen.add(key);
    return true;
  });
};

const matchedGroups = clusterGroups.filter((group) => group.matches.some((term) => haystack.includes(term)));
const relatedSourceLinks = matchedGroups.length
  ? [...priorityBridgeLinks, ...interleaveLinks(matchedGroups, 8)]
  : [...priorityBridgeLinks, ...fallbackLinks];
const relatedLinks = uniqueLinks(relatedSourceLinks).slice(0, 12);
const decisionLinks = uniqueLinks(coreLinks).slice(0, 11);
const actionLinks = uniqueLinks(nextStepLinks);
---

