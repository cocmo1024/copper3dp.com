---

<section class="mb-12 border-y border-page-border py-8 text-left md:mb-16" aria-labelledby="engineering-topic-clusters">
  <div class="mx-auto max-w-3xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-primary">Topic clusters</p>
    <h2
      id="engineering-topic-clusters"
      class="mt-2 font-heading text-2xl font-bold leading-tight text-heading md:text-3xl"
    >
      Find the right copper AM path before requesting a quote
    </h2>
    <p class="mt-3 text-base leading-7 text-muted">
      These clusters connect the strongest engineering pages by buyer intent, application, material route, and
      validation risk.
    </p>
  </div>

  <div class="mt-8 grid gap-x-8 gap-y-9 md:grid-cols-2">
    {
      clusters.map((cluster) => (
        <section aria-labelledby={`cluster-${cluster.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
          <h3
            id={`cluster-${cluster.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
            class="font-heading text-lg font-semibold leading-tight text-heading"
          >
            {cluster.title}
          </h3>
          <p class="mt-2 text-sm leading-6 text-muted">{cluster.description}</p>
          <ul class="mt-4 space-y-3">
            {cluster.links.map((link) => (
              <li>
                <a class="font-semibold text-link hover:underline" href={link.href}>
                  {link.title}
                </a>
                <p class="mt-1 text-sm leading-6 text-muted">{link.description}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</section>
